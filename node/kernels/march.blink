// RayField: the air along each pixel's ray, from the camera out to the surface (the unfiltered depth) or as far as
// the haze reaches (where it sees sky: to where the ray leaves the set, or Haze reaches). At each step: the haze's density (even haze, ground fog, breakup), the light that reaches the
// point (shadows from the light map, the cuc, the cone, falloff, fade), how much of it scatters toward the camera
// (glow toward the light), and ambient haze; all dimmed by the haze in front. Runs at the size of the space image
// (a fraction of the frame) and starts each pixel's steps at a fixed offset (stratified), so there is no banding.
// Out: rgb = the light the air adds, a = how much the haze hides what is behind it. Mirrors reference.march.
kernel RFMarch : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint, eEdgeClamped> space;
  Image<eRead, eAccessRandom, eEdgeClamped> surf;
  Image<eRead, eAccessRandom, eEdgeClamped> info;
  Image<eRead, eAccessRandom, eEdgeClamped> lmap;
  Image<eRead, eAccessRandom, eEdgeClamped> cuc;
  Image<eRead, eAccessRandom, eEdgeClamped> noise;
  Image<eWrite> dst;

  param:
//@decl

  local:
    float Wf;
    float Hf;
    float sxf;
    float syf;
    float3 Lfwd;
    float3 Lright;
    float3 Lup;
    float3 Ltoward;
    float3 Lpos;
    float tanc;
    float3 col;
    float3 amb;
    float3 drift_off;

  void define() {
//@define
  }

//@params cam_pos cam_right cam_up cam_back cam_th light_type aim light_az light_el roll light_dist cone su lm_n
//@params cone_soft falloff light_k light_col haze glow ambient ambient_rgb fade fog fog_height fog_falloff breakup
//@params breakup_size drift drift_dir frame fps seed use_cuc cuc_size cuc_aspect cuc_outside steps octaves reach
//@include lib_math
//@include lib_hash
//@include lib_cam
//@include lib_light
//@include lib_lighting

  void init() {
    Wf = float(surf.bounds.width());
    Hf = float(surf.bounds.height());
    sxf = Wf / float(space.bounds.width());
    syf = Hf / float(space.bounds.height());
    light_setup();
    col = light_col * kelvin_rgb(light_k);
    amb = ambient_rgb * (ambient * (0.2126f * col.x + 0.7152f * col.y + 0.0722f * col.z));
    float a = drift_dir * 0.0174532925f;
    drift_off = float3(cos(a), 0.0f, sin(a)) * (drift * frame / fps);
  }

  // the two noises at voxel coordinates q (trilinear, wrapping every 64 voxels)
  float2 noise_at(float3 q) {
    float fx = floor(q.x);
    float fy = floor(q.y);
    float fz = floor(q.z);
    int i0 = posmodi(int(fx), 64);
    int j0 = posmodi(int(fy), 64);
    int k0 = posmodi(int(fz), 64);
    int i1 = (i0 + 1) % 64;
    int j1 = (j0 + 1) % 64;
    int k1 = (k0 + 1) % 64;
    float wx = q.x - fx;
    float wy = q.y - fy;
    float wz = q.z - fz;
    int nx = noise.bounds.x1;
    int ny = noise.bounds.y1;
    int ax = nx + (k0 % 8) * 64;
    int ay = ny + (k0 / 8) * 64;
    int bx = nx + (k1 % 8) * 64;
    int by = ny + (k1 / 8) * 64;
    float4 a00 = noise(ax + i0, ay + j0);
    float4 a10 = noise(ax + i1, ay + j0);
    float4 a01 = noise(ax + i0, ay + j1);
    float4 a11 = noise(ax + i1, ay + j1);
    float4 b00 = noise(bx + i0, by + j0);
    float4 b10 = noise(bx + i1, by + j0);
    float4 b01 = noise(bx + i0, by + j1);
    float4 b11 = noise(bx + i1, by + j1);
    float4 a = (a00 * (1.0f - wx) + a10 * wx) * (1.0f - wy) + (a01 * (1.0f - wx) + a11 * wx) * wy;
    float4 b = (b00 * (1.0f - wx) + b10 * wx) * (1.0f - wy) + (b01 * (1.0f - wx) + b11 * wx) * wy;
    float4 r = a * (1.0f - wz) + b * wz;
    return float2(r.x, r.y);
  }

  // where the camera's ray leaves the set's box (padded as the light map pads it); 0 if it misses the box
  float box_exit(float3 d, float3 lo, float3 hi) {
    float pad = 0.01f * len3(hi - lo) + 0.01f / su;
    float3 lo2 = lo - float3(pad);
    float3 hi2 = hi + float3(pad);
    float dx = fabs(d.x) < 1e-9f ? 1e-9f : d.x;
    float dy = fabs(d.y) < 1e-9f ? 1e-9f : d.y;
    float dz = fabs(d.z) < 1e-9f ? 1e-9f : d.z;
    float ax = (lo2.x - cam_pos.x) / dx;
    float bx = (hi2.x - cam_pos.x) / dx;
    float ay = (lo2.y - cam_pos.y) / dy;
    float by = (hi2.y - cam_pos.y) / dy;
    float az = (lo2.z - cam_pos.z) / dz;
    float bz = (hi2.z - cam_pos.z) / dz;
    float tn = max(max(min(ax, bx), min(ay, by)), min(az, bz));
    float tf = min(min(max(ax, bx), max(ay, by)), max(az, bz));
    return (tf > max(tn, 0.0f)) ? tf : 0.0f;
  }

  // the haze's density at X, per metre
  float density(float3 X) {
    float ym = X.y * su;
    float base = haze + fog * exp(-max(ym - fog_height, 0.0f) / max(fog_falloff, 0.01f));
    float sig = base * @HAZE_K@;
    if (breakup > 0.0f) {
      float3 q = (X * su + drift_off) / breakup_size * 8.0f;
      float n = noise_at(q).x;
      if (octaves > 1) {
        float3 q2 = float3(0.8f * q.x - 0.36f * q.y + 0.48f * q.z, 0.6f * q.x + 0.48f * q.y - 0.64f * q.z,
                           0.8f * q.y + 0.6f * q.z) * 2.17f + float3(17.3f, 5.1f, 31.7f);
        n = 0.62f * n + 0.38f * noise_at(q2).y;
      }
      float m = clamp((n - 0.5f) * 3.0f + 0.5f, 0.0f, 1.0f);
      sig = sig * max(1.0f + breakup * (2.0f * m - 1.0f), 0.0f);
    }
    return sig;
  }

  void process(int2 xy) {
    float4 f0 = info(info.bounds.x1, info.bounds.y1);
    float4 f1 = info(info.bounds.x1 + 1, info.bounds.y1);
    float4 f2 = info(info.bounds.x1 + 2, info.bounds.y1);
    float3 lf = float3(f2.x, f2.y, f2.z);
    float rch = f1.w;
    int W = surf.bounds.width();
    int H = surf.bounds.height();
    int ix = clampi(int((float(xy.x - space.bounds.x1) + 0.5f) * sxf), 0, W - 1);
    int iy = clampi(int((float(xy.y - space.bounds.y1) + 0.5f) * syf), 0, H - 1);
    float4 s = surf(surf.bounds.x1 + ix, surf.bounds.y1 + iy);
    float3 d = ray_dir(float(ix) + 0.5f, float(iy) + 0.5f);
    float D = 0.0f;
    if (s.y >= 0.02f && s.x > 0.0f) {
      D = min(s.x, rch);
    } else if (reach > 0.0f) {
      D = rch;
    } else {
      D = min(box_exit(d, float3(f0.x, f0.y, f0.z), float3(f1.x, f1.y, f1.z)), rch);
    }
    // where this pixel's steps start: stratified over each 4 x 4 block of pixels (an ordered pattern, shuffled within
    // its slot by the hash), so the upsample's filter averages the offsets out
    int mx = xy.x - space.bounds.x1;
    int my = xy.y - space.bounds.y1;
    int xa = (mx ^ my) & 3;
    int bay = ((xa & 1) << 3) | ((my & 1) << 2) | (((xa >> 1) & 1) << 1) | ((my >> 1) & 1);
    float jit = (float(bay) + u01(hash_more(hash_more(hash1(word(@JITTER@)), word(mx)), word(my)))) / 16.0f;
    float dt = D / float(steps);
    float dtm = dt * su;
    float T = 1.0f;
    float3 acc = float3(0.0f);
    for (int k = 0; k < steps; k++) {
      float t = (float(k) + jit) * dt;
      float3 X = cam_pos + d * t;
      float sig = density(X);
      if (sig <= 0.0f) {
        continue;
      }
      float a = 1.0f - exp(-sig * dtm);
      float3 li = float3(0.0f);
      float4 c = light_coords(X);
      if (c.w > 0.0f) {
        float2 tx = texel_of(c.x, c.y, lf);
        float w = shadow_at(tx.x, tx.y, c.z, 0.0f);
        if (w > 0.0f) {
          w = w * light_weight(c.x, c.y, c.z, tx.x, tx.y);
          float3 Ld = light_type == 0 ? Lfwd : unit3(X - Lpos);
          w = w * hg(-dot(Ld, d), glow);
          float3 cc = use_cuc == 1 ? cuc_at(c.x, c.y) : float3(1.0f);
          li = col * cc * w;
        }
      }
      acc += (li + amb) * (T * a);
      T = T * (1.0f - a);
    }
    dst() = float4(acc.x, acc.y, acc.z, 1.0f - T);
  }
};
