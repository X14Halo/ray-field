BlinkScript {
 inputs 3
 kernelSource "// RayField: the march's picture back at full resolution. Each pixel blends the nearby march pixels, weighted by how\n// close they are and by how close their depth is to this pixel's, so the atmosphere keeps the set's edges (and the\n// steps' random offsets average out). Mirrors reference.upsample.\nkernel RFUp : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eRead, eAccessRandom, eEdgeClamped> mar;\n  Image<eRead, eAccessRandom, eEdgeClamped> info;\n  Image<eWrite> dst;\n\n  param:\n    float su;\n  local:\n    float sxf;\n    float syf;\n\n  void define() \{\n    defineParam(su, \"su\", 0.01f);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  void init() \{\n    sxf = float(surf.bounds.width()) / float(mar.bounds.width());\n    syf = float(surf.bounds.height()) / float(mar.bounds.height());\n  \}\n\n  float depth_at(int x, int y, float rch) \{\n    float4 s = surf(surf.bounds.x1 + x, surf.bounds.y1 + y);\n    return (s.y >= 0.02f && s.x > 0.0f) ? min(s.x, rch) : rch;\n  \}\n\n  void process(int2 xy) \{\n    float rch = info(info.bounds.x1 + 1, info.bounds.y1).w;\n    int W = surf.bounds.width();\n    int H = surf.bounds.height();\n    int w = mar.bounds.width();\n    int h = mar.bounds.height();\n    int x = xy.x - surf.bounds.x1;\n    int y = xy.y - surf.bounds.y1;\n    float Dp = depth_at(x, y, rch);\n    float lx = (float(x) + 0.5f) / sxf - 0.5f;\n    float ly = (float(y) + 0.5f) / syf - 0.5f;\n    int i0 = int(floor(lx)) - 1;\n    int j0 = int(floor(ly)) - 1;\n    float4 acc = float4(0.0f);\n    float wsum = 0.0f;\n    float4 best = float4(0.0f);\n    float bestd = 1e30f;\n    float eps = 0.01f / su;\n    float isg = 1.0f / (0.85f * 0.85f);\n    for (int b = 0; b < 4; b++) \{\n      for (int a = 0; a < 4; a++) \{\n        int iu = i0 + a;\n        int ju = j0 + b;\n        int i = clampi(iu, 0, w - 1);\n        int j = clampi(ju, 0, h - 1);\n        int qx = clampi(int((float(i) + 0.5f) * sxf), 0, W - 1);\n        int qy = clampi(int((float(j) + 0.5f) * syf), 0, H - 1);\n        float Dq = depth_at(qx, qy, rch);\n        float ex = float(iu) - lx;\n        float ey = float(ju) - ly;\n        float ws = exp(-0.5f * (ex * ex + ey * ey) * isg);\n        float rel = (Dq - Dp) / (0.02f * Dp + eps);\n        float wt = ws * exp(-0.5f * rel * rel);\n        float4 m = mar(mar.bounds.x1 + i, mar.bounds.y1 + j);\n        acc += m * wt;\n        wsum += wt;\n        float dd = fabs(Dq - Dp);\n        if (dd < bestd) \{\n          bestd = dd;\n          best = m;\n        \}\n      \}\n    \}\n    dst() = wsum > 1e-4f ? acc / wsum : best;\n  \}\n\};\n"
 rebuild ""
