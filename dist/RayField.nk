set cut_paste_input [stack 0]
version 15.0 v1
push 0
push 0
push $cut_paste_input
Group {
 inputs 3
 name RayField1
 tile_color 0xb08a3aff
 label "\[value light_type]"
 note_font "Verdana Bold"
 help "RayField 0.1.0: light shafts (godrays) and haze for comp, from the shot's utility pass (position, depth, normals; the camera from the EXR header), shadowed by the set and held out by it, with a paintable cuc projected through the light. Plus or over it on the comp. Inputs: utility (the utility pass Read), plate (optional, to judge the look), cuc (optional: any image to project through the light, such as a RotoPaint)."
 onCreate "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_n = nuke.thisNode()\ntry:\n    _rf(_n).created(_n)\nexcept Exception:\n    pass\n"
 knobChanged "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_n = nuke.thisNode()\n_k = nuke.thisKnob()\nif _k.name() in ('inputChange', 'showPanel', 'aim_xy', 'light_type', 'cuc_on', 'units'):\n    _rf(_n).knob_changed(_n, _k)\n"
 addUserKnob {20 tab_rayfield l RayField}
 addUserKnob {26 rf_status l "" +STARTLINE T "connect the utility pass to the <b>utility</b> input"}
 addUserKnob {22 read_camera l "Read camera" T "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_rf(nuke.thisNode()).button(nuke.thisNode(), 'read_camera')\n" +STARTLINE}
 addUserKnob {22 check_shot l "Check shot" T "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_rf(nuke.thisNode()).button(nuke.thisNode(), 'check_shot')\n"}
 addUserKnob {26 div_rayf_1 l "<b>Light</b>"}
 addUserKnob {4 light_type l Light t "Sun: parallel light from far away (through windows, trees, clouds). Spot: a lamp with a cone, placed Distance away from the aim point." M {sun spot}}
 light_type sun
 addUserKnob {12 aim_xy l "Lands here" t "Drag this handle in the viewer onto the set, where the light should land. The node reads the point under it from the utility pass and sets the Aim point. (pixels)"}
 aim_xy {960 540}
 addUserKnob {13 aim l "Aim point" t "Where the light is aimed, in the scene (set by the Lands here handle). The cuc is centred on it, and a spot points at it. (scene units)"}
 aim {0 0 0}
 addUserKnob {7 light_az l Heading t "The compass direction the light comes from, in degrees (0: the light travels toward +X). (degrees)" R -180 180}
 light_az 25
 addUserKnob {7 light_el l Elevation t "How high the light is, in degrees above the horizon. (degrees)" R -90 90}
 light_el 33
 addUserKnob {7 distance l Distance t "Spot: how far the light is from the aim point, along the light's direction. (metres)" R 0.2 30}
 distance 4
 addUserKnob {7 cone l "Cone angle" t "Spot: the full width of the light's cone. (degrees)" R 1 170}
 cone 40
 addUserKnob {7 cone_soft l "Cone softness" t "Spot: how soft the cone's edge is (0 = hard, 1 = soft all the way in)." R 0 1}
 cone_soft 0.2
 addUserKnob {7 intensity l Intensity t "How bright the light is (linear)." R 0 20}
 intensity 1
 addUserKnob {7 exposure l Exposure t "Brightness in stops, on top of Intensity. (stops)" R -6 6}
 exposure 0
 addUserKnob {18 light_rgb l Colour t "The light's colour (times its temperature)."}
 light_rgb {1 1 1}
 addUserKnob {7 light_k l Temperature t "The light's colour temperature. (kelvin)" R 1500 12000}
 light_k 5600
 addUserKnob {26 div_rayf_2 l "<b>Air</b>"}
 addUserKnob {7 haze l Haze t "How thick the air is. More haze: brighter shafts, and more of the background hidden (with Alpha set to matte)." R 0 2}
 haze 0.3
 addUserKnob {7 glow l "Glow toward light" t "How much brighter the air is when you look toward the light (forward scattering). 0 = the same from every side." R 0 0.95}
 glow 0.5
 addUserKnob {7 ambient l "Ambient haze" t "Haze lit by the rest of the scene, in shadow too, as a fraction of the light." R 0 1}
 ambient 0.02
 addUserKnob {7 fog l "Ground fog" t "Extra haze low down, thinning out above Fog height." R 0 5}
 fog 0
 addUserKnob {7 fog_height l "Fog height" t "Height (world Y) below which the ground fog is thickest. (metres)" R -5 20}
 fog_height 0.5
 addUserKnob {7 fog_falloff l "Fog falloff" t "How quickly the ground fog thins out above its height. (metres)" R 0.01 10}
 fog_falloff 0.5
 addUserKnob {7 breakup l Breakup t "How patchy the haze is (0 = even)." R 0 1}
 breakup 0.5
 addUserKnob {7 breakup_size l "Breakup size" t "The size of the patches. (metres)" R 0.02 10}
 breakup_size 0.6
 addUserKnob {7 drift l Drift t "How fast the patches drift. (metres per second)" R 0 2}
 drift 0.05
 addUserKnob {26 div_rayf_3 l "<b>Cuc</b>"}
 addUserKnob {6 cuc_on l "Use cuc" t "Project the image on the cuc input through the light: white lets light through, black blocks it, colours tint it." +STARTLINE}
 cuc_on true
 addUserKnob {4 cuc_from l "Cuc from" t "Which channels of the cuc input to use: rgb (RotoPaint, a texture), or alpha (a Roto shape)." M {rgb alpha}}
 cuc_from rgb
 addUserKnob {7 cuc_size l "Cuc size" t "Sun: how wide the cuc is where it lands, centred on the aim point. (A spot's cuc always fills its cone.) (metres)" R 0.1 50}
 cuc_size 3
 addUserKnob {7 roll l "Cuc roll" t "Turns the cuc about the light's direction. (degrees)" R -180 180}
 roll 0
 addUserKnob {7 cuc_soft l "Cuc softness" t "Blurs the cuc, as a percentage of its width. (%)" R 0 10}
 cuc_soft 0
 addUserKnob {4 cuc_outside l "Around the cuc" t "Sun: what the light does outside the cuc image: dark (the cuc is a board with holes), light (only the cuc's own shapes block), or repeat (tile it)." M {dark light repeat}}
 cuc_outside dark
 addUserKnob {26 div_rayf_4 l "<b>Output</b>"}
 addUserKnob {4 output_mode l Output t "What the node puts out: the atmosphere alone (to plus or over in your comp), or over / plus the plate input, to judge it." M {atmosphere "over plate" "plus plate"}}
 output_mode atmosphere
 addUserKnob {4 alpha_out l Alpha t "none: rgb only, to plus onto the comp. matte: alpha is how much the haze hides what is behind it, so over gives fog that also thins the background." M {none matte}}
 alpha_out none
 addUserKnob {4 view l View t "result: the atmosphere. light on set: the light (with its shadows and cuc) painted onto the set, to aim it." M {result "light on set"}}
 view result
 addUserKnob {4 viewer_quality l "Viewer quality" t "Quality in the viewer. preview: quarter resolution, fewer steps (fast to tune). final: half resolution. best: full resolution, most steps." M {preview final best}}
 viewer_quality preview
 addUserKnob {4 render_quality l "Render quality" t "Quality when rendering (Write nodes, the farm)." M {preview final best}}
 render_quality final
 addUserKnob {6 use_gpu l "Use GPU" t "Render on the GPU when there is one (much faster). The result is the same either way." +STARTLINE}
 use_gpu true
 addUserKnob {26 rf_report l "" +STARTLINE T ""}
 addUserKnob {20 tab_more l More}
 addUserKnob {26 div_more_1 l "<b>Light & air</b>"}
 addUserKnob {7 falloff l "Distance falloff" t "Spot: how the light dims with distance. 1 = as a real lamp (inverse square, as bright as set at the aim point), 0 = not at all." R 0 1}
 falloff 1
 addUserKnob {7 fade l "Shaft fade" t "Shafts fade out over about this distance after they enter the set (0 = only as the haze dims them). (metres)" R 0 30}
 fade 0
 addUserKnob {18 ambient_rgb l "Ambient colour" t "The colour of the ambient haze."}
 ambient_rgb {0.85 0.92 1}
 addUserKnob {7 drift_dir l "Drift heading" t "Which way the patches drift, in degrees (0 = toward +X). (degrees)" R -180 180}
 drift_dir 0
 addUserKnob {3 seed l Seed t "Picks a different pattern of patches."}
 seed 1
 addUserKnob {7 reach l "Haze reaches" t "How far from the camera the haze goes. 0 = automatic: a bit past most of the set, and where the camera sees sky, to where its ray leaves the set (so the outside seen through a window keeps the haze it has in the plate). (metres)" R 0 200}
 reach 0
 addUserKnob {26 div_more_2 l "<b>Shadows</b>"}
 addUserKnob {4 shadows l Shadows t "Where the shadows in the air come from: the set as the utility pass shows it, or none." M {"from the pass" none}}
 shadows "from the pass"
 addUserKnob {6 interior l "Light only through openings" t "For rooms: the pass only shows what the camera sees, so light only gets in where its path leaves the set through what the camera sees as sky or the far outside (a window, a door). Turn it on when light leaks in from walls the camera cannot see." +STARTLINE}
 interior false
 addUserKnob {7 thick l Thickness t "How thick things are taken to be behind the surfaces the camera sees, when they block light. (metres)" R 0.02 3}
 thick 0.4
 addUserKnob {20 tab_shot l Shot}
 addUserKnob {26 div_shot_1 l "<b>Frames and units</b>"}
 addUserKnob {3 first l "First frame" t "The shot's first frame (from the utility Read when connected)."}
 first 1001
 addUserKnob {3 last l "Last frame" t "The shot's last frame."}
 last 1048
 addUserKnob {7 fps l "Frames per second" t "For the drift speed." R 1 60}
 fps 24
 addUserKnob {4 units l "Scene units" t "What one unit in the utility pass is." M {centimetres metres millimetres inches feet}}
 units centimetres
 addUserKnob {26 div_shot_2 l "<b>Layers of the utility pass</b>"}
 addUserKnob {41 layer_pos l Position T rf_pos.in}
 addUserKnob {41 layer_cov l Coverage T rf_pos.in2}
 addUserKnob {41 layer_depth l Depth T rf_depth.in}
 addUserKnob {41 layer_zraw l "Unfiltered depth" T rf_depth.in2}
 addUserKnob {41 layer_nrm l Normals T rf_nrm.in}
 addUserKnob {22 find_layers l "Find layers" T "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_rf(nuke.thisNode()).button(nuke.thisNode(), 'find_layers')\n" +STARTLINE}
 addUserKnob {4 p_premult l "Positions premultiplied" t "Whether the position layer was premultiplied by coverage. auto = worked out from the pass (by reprojecting edge pixels)." M {auto no yes}}
 p_premult auto
 addUserKnob {4 z_kind l "Depth is distance along the view axis" t "auto = worked out by comparing with the positions; no = distance along each pixel's ray." M {auto no yes}}
 z_kind auto
 addUserKnob {4 z_premult l "Depth premultiplied" t "Whether the depth layers were premultiplied by coverage. auto = worked out from the pass." M {auto no yes}}
 z_premult auto
 addUserKnob {26 div_shot_3 l "<b>Camera (read from the pass header)</b>"}
 addUserKnob {13 cam_pos l Position}
 addUserKnob {13 cam_right l Right}
 addUserKnob {13 cam_up l Up}
 addUserKnob {13 cam_back l Back}
 cam_pos {0 150 400}
 cam_right {1 0 0}
 cam_up {0 1 0}
 cam_back {0 0 1}
 addUserKnob {7 cam_th l "tan(half view angle)" R 0 2}
 cam_th 0.5
 addUserKnob {7 hdr_focal l "Focal length (mm)" R 0 100}
 addUserKnob {7 hdr_film l "Film back width (mm)" R 0 100}
 addUserKnob {7 hdr_fstop l f-stop R 0 100}
 addUserKnob {7 hdr_focus l "Focus distance" R 0 100}
 addUserKnob {7 hdr_cateye l Cat-eye R 0 100}
 addUserKnob {7 hdr_anamorphic l "Anamorphic aspect" R 0 100}
 addUserKnob {7 hdr_field_curv l "Field curvature" R 0 100}
 addUserKnob {7 hdr_fstop_full l "Full-aperture f-stop" R 0 100}
 addUserKnob {3 hdr_blades l "Blade count"}
 addUserKnob {7 shutter l "Shutter angle" t "Read from the pass header (for motion blur, in a later version)." R 0 360}
 shutter 180
 addUserKnob {4 shutter_mode l Shutter t "Read from the pass header." M {backward centred forward}}
 shutter_mode backward
 addUserKnob {4 shutter_shape l "Shutter shape" t "Read from the pass header." M {backwardsShape box}}
 shutter_shape backwardsShape
 addUserKnob {22 repair l "Repair node" T "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_rf(nuke.thisNode()).button(nuke.thisNode(), 'repair')\n" +STARTLINE}
 addUserKnob {26 rf_about l "" +STARTLINE T "RayField 0.1.0: light shafts and haze in comp from the utility pass. Nothing to install; it writes no files."}
 addUserKnob {1 rf_cam_src +INVISIBLE}
 rf_cam_src ""
 addUserKnob {6 rf_layers_set +INVISIBLE}
 rf_layers_set false
 addUserKnob {6 rf_shutter_read +INVISIBLE}
 rf_shutter_read false
 addUserKnob {6 rf_aim_set +INVISIBLE}
 rf_aim_set false
 addUserKnob {3 rf_has_cuc +INVISIBLE}
 rf_has_cuc 0
 addUserKnob {1 rf_version +INVISIBLE}
 rf_version ""
 addUserKnob {7 rf_cuc_aspect +INVISIBLE}
 rf_cuc_aspect 1
 addUserKnob {3 rf_q +INVISIBLE}
 rf_q {{$gui?viewer_quality:render_quality}}
 addUserKnob {7 rf_res +INVISIBLE}
 rf_res {{rf_q==0?0.25:rf_q==1?0.5:1}}
 addUserKnob {7 rf_steps +INVISIBLE}
 rf_steps {{rf_q==0?48:rf_q==1?96:128}}
 addUserKnob {7 rf_lm +INVISIBLE}
 rf_lm {{rf_q==0?512:1024}}
 addUserKnob {7 rf_lm_steps +INVISIBLE}
 rf_lm_steps {{rf_q==0?160:rf_q==1?224:256}}
 addUserKnob {7 rf_oct +INVISIBLE}
 rf_oct {{rf_q==0?1:2}}
 addUserKnob {1 rf_py +INVISIBLE}
 rf_py "\"\"\"RayField node helpers: the Python that lives inside the node (in its hidden rf_py knob), so there is nothing to\ninstall. The node runs it from memory; it never writes a file. Much of it comes from MoteField's node.\n\nWhat it does:\n  * setup        wires the internal nodes and links every kernel setting to the node's knobs (runs when the node is\n                 created or opened, so a script saved by any Nuke version comes back right);\n  * layers       finds the position, normals, depth and coverage layers by name;\n  * camera       reads the camera (and lens and shutter) from the pass's EXR header, frame by frame;\n  * aim          the Lands here handle: reads the point under it from the pass and sets the Aim point;\n  * cuc          notices the cuc input and its shape;\n  * check        reports what the node found out about the pass and the light.\n\nLINKS, KERNELS and WIRES are filled in by node/build_node.py.\n\"\"\"\nimport json\nimport math\nimport re\n\nimport nuke\n\nVERSION = '0.1.0'\nLINKS = \{'rf_facts': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th'\}, 'rf_surface': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th', 'p_premult': 'parent.p_premult-1', 'z_kind': 'parent.z_kind-1', 'z_premult': 'parent.z_premult-1'\}, 'rf_frame': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th', 'light_type': 'parent.light_type', 'aim': \['parent.aim.x', 'parent.aim.y', 'parent.aim.z'\], 'light_az': 'parent.light_az', 'light_el': 'parent.light_el', 'roll': 'parent.roll', 'light_dist': 'parent.distance', 'cone': 'parent.cone', 'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048', 'reach': 'parent.reach', 'lm_n': 'parent.rf_lm'\}, 'rf_blocks': \{\}, 'rf_openings': \{\}, 'rf_lightmap': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th', 'light_type': 'parent.light_type', 'aim': \['parent.aim.x', 'parent.aim.y', 'parent.aim.z'\], 'light_az': 'parent.light_az', 'light_el': 'parent.light_el', 'roll': 'parent.roll', 'light_dist': 'parent.distance', 'cone': 'parent.cone', 'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048', 'lm_n': 'parent.rf_lm', 'lm_steps': 'parent.rf_lm_steps', 'thick': 'parent.thick', 'interior': 'parent.interior', 'shadows': 'parent.shadows'\}, 'rf_noise': \{'seed': 'parent.seed'\}, 'rf_march': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th', 'light_type': 'parent.light_type', 'aim': \['parent.aim.x', 'parent.aim.y', 'parent.aim.z'\], 'light_az': 'parent.light_az', 'light_el': 'parent.light_el', 'roll': 'parent.roll', 'light_dist': 'parent.distance', 'cone': 'parent.cone', 'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048', 'lm_n': 'parent.rf_lm', 'cone_soft': 'parent.cone_soft', 'falloff': 'parent.falloff', 'light_k': 'parent.light_k', 'light_col': \['parent.light_rgb.r*parent.intensity*pow(2,parent.exposure)', 'parent.light_rgb.g*parent.intensity*pow(2,parent.exposure)', 'parent.light_rgb.b*parent.intensity*pow(2,parent.exposure)'\], 'haze': 'parent.haze', 'glow': 'parent.glow', 'ambient': 'parent.ambient', 'ambient_rgb': \['parent.ambient_rgb.r', 'parent.ambient_rgb.g', 'parent.ambient_rgb.b'\], 'fade': 'parent.fade', 'fog': 'parent.fog', 'fog_height': 'parent.fog_height', 'fog_falloff': 'parent.fog_falloff', 'breakup': 'parent.breakup', 'breakup_size': 'parent.breakup_size', 'drift': 'parent.drift', 'drift_dir': 'parent.drift_dir', 'frame': 'frame', 'fps': 'parent.fps', 'seed': 'parent.seed', 'use_cuc': 'parent.cuc_on*parent.rf_has_cuc', 'cuc_size': 'parent.cuc_size', 'cuc_aspect': 'parent.rf_cuc_aspect', 'cuc_outside': 'parent.cuc_outside', 'steps': 'parent.rf_steps', 'octaves': 'parent.rf_oct', 'reach': 'parent.reach'\}, 'rf_up': \{'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048'\}, 'rf_onset': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th', 'light_type': 'parent.light_type', 'aim': \['parent.aim.x', 'parent.aim.y', 'parent.aim.z'\], 'light_az': 'parent.light_az', 'light_el': 'parent.light_el', 'roll': 'parent.roll', 'light_dist': 'parent.distance', 'cone': 'parent.cone', 'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048', 'lm_n': 'parent.rf_lm', 'cone_soft': 'parent.cone_soft', 'falloff': 'parent.falloff', 'light_k': 'parent.light_k', 'light_col': \['parent.light_rgb.r*parent.intensity*pow(2,parent.exposure)', 'parent.light_rgb.g*parent.intensity*pow(2,parent.exposure)', 'parent.light_rgb.b*parent.intensity*pow(2,parent.exposure)'\], 'haze': 'parent.haze', 'fade': 'parent.fade', 'use_cuc': 'parent.cuc_on*parent.rf_has_cuc', 'cuc_size': 'parent.cuc_size', 'cuc_aspect': 'parent.rf_cuc_aspect', 'cuc_outside': 'parent.cuc_outside'\}\}            # kernel node -> \{param: expression or \[expressions per component\]\}\nKERNELS = \{'rf_facts': 'RFFacts', 'rf_surface': 'RFSurface', 'rf_frame': 'RFFrame', 'rf_blocks': 'RFBlocks', 'rf_openings': 'RFOpenings', 'rf_lightmap': 'RFLightMap', 'rf_noise': 'RFNoise', 'rf_march': 'RFMarch', 'rf_up': 'RFUp', 'rf_onset': 'RFOnSet'\}          # kernel node -> kernel name (the prefix of its param knobs)\nWIRES = \{'rf_facts': \['rf_space_facts', 'rf_pos', 'rf_depth'\], 'rf_surface': \['rf_pos', 'rf_depth', 'rf_facts'\], 'rf_frame': \['rf_space_frame', 'rf_surface'\], 'rf_blocks': \['rf_low8', 'rf_surface', 'rf_frame'\], 'rf_openings': \['rf_blocks'\], 'rf_lightmap': \['rf_space_lightmap', 'rf_surface', 'rf_frame', 'rf_openings'\], 'rf_noise': \['rf_space_noise'\], 'rf_march': \['rf_low', 'rf_surface', 'rf_frame', 'rf_lightmap', 'rf_cuc', 'rf_noise'\], 'rf_up': \['rf_surface', 'rf_march', 'rf_frame'\], 'rf_onset': \['rf_surface', 'rf_nrm', 'rf_frame', 'rf_lightmap', 'rf_cuc'\], 'rf_fmt': \['utility'\], 'rf_pos': \['rf_fmt'\], 'rf_depth': \['rf_fmt'\], 'rf_nrm': \['rf_fmt'\], 'rf_low8': \['rf_surface'\], 'rf_low': \['rf_surface'\], 'rf_cuc_a': \['cuc'\], 'rf_cuc_from': \['cuc', 'rf_cuc_a'\], 'rf_cuc_sq': \['rf_cuc_from'\], 'rf_cuc_soft': \['rf_cuc_sq'\], 'rf_cuc': \['rf_cuc_soft'\], 'rf_crop': \['rf_up'\], 'rf_alpha': \['rf_crop'\], 'rf_over': \['plate', 'rf_crop'\], 'rf_plus': \['plate', 'rf_alpha'\], 'rf_result': \['rf_alpha', 'rf_over', 'rf_plus'\], 'rf_view': \['rf_result', 'rf_onset'\], 'Output1': \['rf_view'\]\}            # internal node -> \[input node names\] (None = leave unconnected)\nUNITS = (0.01, 1.0, 0.001, 0.0254, 0.3048)          # metres per scene unit, in the order of the Scene units menu\nNAME = 'RayField'\n\n# layer names each kind of data is found under (lower case, letters and digits only)\nROLES = \{\n    'P': ('pos', 'p', 'pworld', 'position', 'worldposition', 'worldpos', 'pw', 'wp', 'ppass', 'world',\n          'positionworld', 'worldp'),\n    'N': ('normal', 'n', 'nworld', 'normals', 'worldnormal', 'nw', 'normalworld', 'nn', 'worldnormals'),\n    'Z': ('depth', 'z', 'zdepth', 'distance', 'depthfiltered'),\n    'Zraw': ('depthnofilter', 'depthunfiltered', 'nofilterdepth', 'depthraw', 'zraw', 'depthclosest',\n             'closestdepth', 'zunfiltered', 'znofilter', 'depthnearest'),\n    'A': ('alpha', 'implicitalpha', 'coverage', 'alphacoverage'),\n\}\n\n\ndef _norm(s):\n    return ''.join(ch for ch in str(s).lower() if ch.isalnum())\n\n\ndef _inner(grp, name):\n    return grp.node(name)\n\n\ndef _idx(knob):\n    \"\"\"The index of a menu knob's value (Nuke's value() gives the item's text, getValue() its index).\"\"\"\n    try:\n        return int(knob.getValue())\n    except (TypeError, ValueError):\n        return 0\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  Setup: wiring and links\n# ---------------------------------------------------------------------------------------------------------------------\ndef wire(grp):\n    \"\"\"Connects every internal node to its inputs by name (the script's own wiring, made certain).\"\"\"\n    for name, inputs in WIRES.items():\n        n = _inner(grp, name)\n        if n is None:\n            continue\n        for i, src in enumerate(inputs):\n            if src is None:\n                continue\n            s = _inner(grp, src)\n            if s is not None and n.input(i) is not s:\n                n.setInput(i, s)\n\n\ndef _param_knob(node, kernel, param):\n    \"\"\"The knob a BlinkScript node made for a kernel param (KernelName_param), or None.\"\"\"\n    k = node.knob(kernel + '_' + param)\n    if k is not None:\n        return k\n    want = (kernel + '_' + param).lower()\n    knobs = node.knobs()\n    for name, k in knobs.items():\n        if name.lower() == want:\n            return k\n    # another naming (a different prefix): the shortest knob name ending in _param\n    ends = sorted((n for n in knobs if n.lower().endswith('_' + param.lower())), key=len)\n    return knobs\[ends\[0\]\] if ends else None\n\n\ndef link_kernel(grp, name):\n    \"\"\"Links one kernel node's params to the node's knobs by expression. Returns the params it could not find.\"\"\"\n    node = _inner(grp, name)\n    if node is None:\n        return \[\]\n    kernel = KERNELS\[name\]\n    missing = \[\]\n    for param, expr in LINKS.get(name, \{\}).items():\n        k = _param_knob(node, kernel, param)\n        if k is None:\n            missing.append(param)\n            continue\n        try:\n            if isinstance(expr, (list, tuple)):\n                for i, e in enumerate(expr):\n                    k.setExpression(e, i)\n            else:\n                k.setExpression(expr)\n        except Exception:\n            missing.append(param)\n    gpu = node.knob('useGPUIfAvailable')\n    if gpu is not None:\n        try:\n            gpu.setExpression('parent.use_gpu')\n        except Exception:\n            pass\n    return missing\n\n\ndef setup(grp):\n    \"\"\"Wires and links everything; returns \{kernel node: \[params not found\]\} for the ones that went wrong.\"\"\"\n    wire(grp)\n    bad = \{\}\n    for name in KERNELS:\n        m = link_kernel(grp, name)\n        if m:\n            bad\[name\] = m\n    k = grp.knob('rf_version')\n    if k is not None and k.value() != VERSION:\n        k.setValue(VERSION)\n    return bad\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  Layers\n# ---------------------------------------------------------------------------------------------------------------------\ndef layers_of(node):\n    \"\"\"\{layer: \[channel names\]\} of a node's output, in order.\"\"\"\n    out = \{\}\n    if node is None:\n        return out\n    try:\n        chans = node.channels()\n    except Exception:\n        return out\n    for c in chans:\n        layer, _, chan = c.partition('.')\n        out.setdefault(layer, \[\]).append(chan)\n    return out\n\n\ndef pick_layer(layers, role):\n    \"\"\"The layer for a role, by name (exact names first, then names that end with one).\"\"\"\n    names = ROLES\[role\]\n    by = dict((_norm(l), l) for l in layers)\n    for n in names:\n        if n in by:\n            return by\[n\]\n    for n in names:\n        if len(n) < 3:\n            continue\n        for k, l in by.items():\n            if k.endswith(n):\n                return l\n    return None\n\n\ndef detect_layers(grp, force=False):\n    \"\"\"Points the internal shuffles at the pass's layers. Returns \{role: layer or None\}.\"\"\"\n    util = grp.input(0)\n    lu = layers_of(util)\n    found = \{\}\n    for role in ('P', 'N', 'Z', 'Zraw', 'A'):\n        found\[role\] = pick_layer(lu, role)\n    if found\['Z'\] is not None and found\['Z'\] == found\['Zraw'\]:\n        found\['Z'\] = None\n    if not force and grp.knob('rf_layers_set') is not None and grp\['rf_layers_set'\].value():\n        return found\n    pos, dep, nrm = (_inner(grp, n) for n in ('rf_pos', 'rf_depth', 'rf_nrm'))\n    if pos is not None:\n        pos\['in'\].setValue(found\['P'\] or 'none')\n        if found\['A'\] and found\['A'\] != 'rgba':\n            pos\['in2'\].setValue(found\['A'\])\n            pos\['alpha'\].setValue('red2')\n        else:\n            pos\['in2'\].setValue('rgba')\n            pos\['alpha'\].setValue('alpha2')\n    if dep is not None:\n        dep\['in'\].setValue(found\['Z'\] or 'none')\n        dep\['in2'\].setValue(found\['Zraw'\] or 'none')\n    if nrm is not None:\n        nrm\['in'\].setValue(found\['N'\] or 'none')\n    if util is not None and grp.knob('rf_layers_set') is not None:\n        grp\['rf_layers_set'\].setValue(True)\n    return found\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  The camera from the EXR header (mirrors motefield/camera.py, without numpy)\n# ---------------------------------------------------------------------------------------------------------------------\n_NUM = re.compile(r'-?(?:\\d+\\.?\\d*|\\.\\d+)(?:\[eE\]\[-+\]?\\d+)?')\n\n\ndef _nums(v):\n    if isinstance(v, bool):\n        return \[float(v)\]\n    if isinstance(v, (list, tuple)):\n        out = \[\]\n        for x in v:\n            out += _nums(x)\n        return out\n    if isinstance(v, (int, float)):\n        return \[float(v)\]\n    if isinstance(v, str):\n        return \[float(x) for x in _NUM.findall(v)\]\n    try:\n        return \[float(x) for x in v\]\n    except Exception:\n        return \[\]\n\n\ndef _flatten_json(prefix, v, out):\n    if isinstance(v, dict):\n        for k, x in v.items():\n            _flatten_json(prefix + '/' + k, x, out)\n    else:\n        out\[prefix\] = v\n\n\ndef header_items(md):\n    \"\"\"(key, value, group) for every metadata entry, then the fields of JSON-valued strings (group = the JSON\n    object's path).\"\"\"\n    plain, nested = \[\], \[\]\n    for k, v in md.items():\n        plain.append((k, v, None))\n        if isinstance(v, str) and v\[:1\] == '\{' and len(v) < 2000000:\n            try:\n                d = json.loads(v)\n            except ValueError:\n                continue\n            flat = \{\}\n            _flatten_json(k, d, flat)\n            nested += \[(fk, fv, fk.rsplit('/', 1)\[0\]) for fk, fv in flat.items()\]\n    return plain + nested\n\n\n_LENS = (('fstop_full', ('fstopfullaperture', 'fullaperture', 'fstopfull', 'maxaperture', 'wideopenfstop')),\n         ('cateye', ('cateyebokeh', 'cateye')),\n         ('field_curv', ('fieldcurvature',)),\n         ('anamorphic', ('anamorphicaspect', 'anamorphicsqueeze', 'squeeze', 'anamorphic')),\n         ('blades', ('bladecount', 'numblades', 'blades', 'irisblades')))\n\n\ndef _rank_groups(items, cam):\n    score = \{\}\n    for k, v, g in items:\n        if g is None:\n            continue\n        kn = _norm(k.rsplit('/', 1)\[-1\])\n        vals = _nums(v)\n        s = score.setdefault(g, 0)\n        for field, ends, w in (('fstop', ('fstop',), 1), ('focus', ('focusdistance',), 1),\n                               ('toworld', ('camtoworld', 'cameratoworld'), 2)):\n            if field in cam and any(kn == e for e in ends) and vals:\n                want = cam\[field\] if isinstance(cam\[field\], list) else \[cam\[field\]\]\n                if len(vals) >= len(want) and all(abs(a - b) <= 1e-3 * max(1.0, abs(b)) for a, b in zip(vals, want)):\n                    s += w\n        score\[g\] = s\n    return score\n\n\ndef _match(k, v, nested, cam, src, lens, take):\n    kn = _norm(k.rsplit('/', 1)\[-1\])\n    full = _norm(k)\n    lens_field = None\n    for f, ends in _LENS:\n        if any(kn.endswith(e) for e in ends):\n            lens_field = f\n            break\n    if lens_field:\n        vals = _nums(v)\n        if vals and lens_field not in lens:\n            lens\[lens_field\] = vals\[0\]\n            src\['lens.' + lens_field\] = k\n        return\n    if kn.endswith('camtoworld') or kn.endswith('cameratoworld'):\n        take('toworld', k, v, 16)\n    elif kn.endswith('worldtocamera') or kn.endswith('worldtocam'):\n        take('w2c', k, v, 16)\n    elif nested:\n        if kn in ('shutteropen', 'shutterclose'):\n            take(kn, k, v)\n        return\n    elif 'horizontalfov' in kn or kn in ('fovx', 'hfov'):\n        take('hfov', k, v)\n    elif kn.endswith('focallength'):\n        take('focal', k, v)\n    elif kn.endswith('fstop') or kn.endswith('fnumber'):\n        take('fstop', k, v)\n    elif kn.endswith('focusdistance'):\n        take('focus', k, v)\n    elif any(kn.endswith(e) for e in ('horizontalaperture', 'filmbackwidth', 'aperturewidth', 'filmwidth',\n                                      'hfilmaperture')):\n        take('aperture', k, v)\n    elif kn.endswith('shutterangle'):\n        take('shutter_angle', k, v)\n    elif kn.endswith('shuttershape') and isinstance(v, str):\n        cam.setdefault('shutter_shape', v)\n        src.setdefault('shutter_shape', k)\n    elif full.endswith('cameradirection') and isinstance(v, str):\n        cam.setdefault('shutter_dir', v)\n        src.setdefault('shutter_dir', k)\n\n\ndef _inv4(m):\n    \"\"\"Inverse of a 4x4 matrix (list of 16, row-major) by Gauss-Jordan elimination.\"\"\"\n    a = \[list(m\[r * 4:r * 4 + 4\]) + \[1.0 if r == c else 0.0 for c in range(4)\] for r in range(4)\]\n    for c in range(4):\n        p = max(range(c, 4), key=lambda r: abs(a\[r\]\[c\]))\n        if abs(a\[p\]\[c\]) < 1e-15:\n            raise ValueError('singular camera matrix')\n        a\[c\], a\[p\] = a\[p\], a\[c\]\n        d = a\[c\]\[c\]\n        a\[c\] = \[x / d for x in a\[c\]\]\n        for r in range(4):\n            if r != c and a\[r\]\[c\] != 0.0:\n                f = a\[r\]\[c\]\n                a\[r\] = \[x - f * y for x, y in zip(a\[r\], a\[c\])\]\n    return \[a\[r\]\[4 + c\] for r in range(4) for c in range(4)\]\n\n\ndef _dot(a, b):\n    return a\[0\] * b\[0\] + a\[1\] * b\[1\] + a\[2\] * b\[2\]\n\n\ndef _unit(a):\n    n = math.sqrt(_dot(a, a)) + 1e-12\n    return \[a\[0\] / n, a\[1\] / n, a\[2\] / n\]\n\n\ndef _cross(a, b):\n    return \[a\[1\] * b\[2\] - a\[2\] * b\[1\], a\[2\] * b\[0\] - a\[0\] * b\[2\], a\[0\] * b\[1\] - a\[1\] * b\[0\]\]\n\n\ndef camera_from_metadata(md):\n    \"\"\"\{'pos', 'right', 'up', 'back', 'th', 'focal', 'film', 'fstop', 'focus', 'lens', 'shutter', 'source'\} from one\n    frame's metadata, or None when it holds no camera.\"\"\"\n    items = header_items(md)\n    cam, src, lens = \{\}, \{\}, \{\}\n\n    def take(field, k, v, n=1):\n        vals = _nums(v)\n        if len(vals) >= n and field not in cam:\n            cam\[field\] = vals\[:n\] if n > 1 else vals\[0\]\n            src\[field\] = k\n\n    for k, v, g in items:\n        if g is None:\n            _match(k, v, False, cam, src, lens, take)\n    score = _rank_groups(items, cam)\n    for k, v, g in sorted(\[it for it in items if it\[2\] is not None\], key=lambda it: -score.get(it\[2\], 0)):\n        _match(k, v, True, cam, src, lens, take)\n    if 'toworld' not in cam and 'w2c' in cam:\n        try:\n            cam\['toworld'\] = _inv4(cam\['w2c'\])\n        except ValueError:\n            return None\n    if 'toworld' not in cam:\n        return None\n    M = \[float(x) for x in cam\['toworld'\]\]\n    rows = \[M\[0:4\], M\[4:8\], M\[8:12\], M\[12:16\]\]\n    if sum(abs(rows\[i\]\[3\]) for i in range(3)) > sum(abs(x) for x in rows\[3\]\[:3\]):   # column-vector convention\n        rows = \[\[rows\[c\]\[r\] for c in range(4)\] for r in range(4)\]\n    back = _unit(rows\[2\]\[:3\])\n    r = rows\[0\]\[:3\]\n    d = _dot(r, back)\n    right = _unit(\[r\[0\] - back\[0\] * d, r\[1\] - back\[1\] * d, r\[2\] - back\[2\] * d\])\n    up = _cross(back, right)\n    focal, ap = cam.get('focal'), cam.get('aperture')\n    if ap is not None and ap < 5:\n        ap *= 25.4\n    if cam.get('hfov'):\n        hfov = math.radians(cam\['hfov'\])\n    elif focal and ap:\n        hfov = 2 * math.atan(ap / (2 * focal))\n    else:\n        return None\n    film = ap if ap else (2 * focal * math.tan(hfov / 2) if focal else None)\n    if 'blades' in lens:\n        lens\['blades'\] = int(round(lens\['blades'\]))\n    shutter = \{\}\n    if 'shutteropen' in cam and 'shutterclose' in cam:\n        o, c = cam\['shutteropen'\], cam\['shutterclose'\]\n        shutter\['angle'\] = abs(c - o) * 360.0\n        shutter\['mode'\] = 'backward' if c <= 0 else 'forward' if o >= 0 else 'centred'\n    if 'shutter_angle' in cam:\n        shutter\['angle'\] = cam\['shutter_angle'\]\n    dn = _norm(cam.get('shutter_dir', ''))\n    if dn in ('backward', 'forward', 'centered', 'centred', 'center', 'centre'):\n        shutter\['mode'\] = 'centred' if dn.startswith('cent') else dn\n    if cam.get('shutter_shape'):\n        shape = _norm(cam\['shutter_shape'\])\n        shutter\['shape'\] = 'backwardsShape' if 'backwardsshape' in shape else \\\n            'box' if shape in ('box', 'square', 'flat') else cam\['shutter_shape'\]\n    return dict(pos=rows\[3\]\[:3\], right=right, up=up, back=back, th=math.tan(hfov / 2), focal=focal, film=film,\n                fstop=cam.get('fstop'), focus=cam.get('focus'), lens=lens, shutter=shutter, source=src)\n\n\ndef _metadata(node, frame):\n    try:\n        return node.metadata(None, frame) or \{\}\n    except TypeError:\n        return node.metadata() or \{\}\n    except Exception:\n        return \{\}\n\n\ndef _same(a, b):\n    return all(abs(x - y) <= 1e-6 * max(1.0, abs(y)) for x, y in zip(a, b))\n\n\nVEC_KNOBS = (('cam_pos', 'pos'), ('cam_right', 'right'), ('cam_up', 'up'), ('cam_back', 'back'))\nHDR_KNOBS = (('hdr_focal', 'focal'), ('hdr_film', 'film'), ('hdr_fstop', 'fstop'), ('hdr_focus', 'focus'))\nLENS_KNOBS = (('hdr_blades', 'blades'), ('hdr_cateye', 'cateye'), ('hdr_anamorphic', 'anamorphic'),\n              ('hdr_field_curv', 'field_curv'), ('hdr_fstop_full', 'fstop_full'))\n\n\ndef _flat(c):\n    return list(c\['pos'\]) + list(c\['right'\]) + list(c\['up'\]) + list(c\['back'\]) + \[c\['th'\]\] + \\\n        \[c\[k\] or 0.0 for k in ('focal', 'film', 'fstop', 'focus')\]\n\n\ndef _set_knob(k, values, frames):\n    \"\"\"Sets a knob to one value (static) or to linear keys per frame. values: list per frame of a number or list.\"\"\"\n    vals0 = values\[0\] if isinstance(values\[0\], (list, tuple)) else \[values\[0\]\]\n    n = len(vals0)\n    static = all(_same(v if isinstance(v, (list, tuple)) else \[v\], vals0) for v in values)\n    for i in range(n):\n        try:\n            k.clearAnimated(i)\n        except Exception:\n            pass\n    if static:\n        k.setValue(vals0 if n > 1 else vals0\[0\])\n        return\n    for i in range(n):\n        k.setAnimated(i)\n        for f, v in zip(frames, values):\n            k.setValueAt((v\[i\] if isinstance(v, (list, tuple)) else v), f, i)\n        try:\n            a = k.animation(i)\n            a.changeInterpolation(a.keys(), nuke.LINEAR)\n        except Exception:\n            pass\n\n\ndef read_camera(grp, frames=None):\n    \"\"\"Reads the camera from the utility input's header on every frame (or the given ones) into the camera knobs.\n    Returns (camera on the first frame or None, 'static' / 'moving', how many frames had one).\"\"\"\n    util = grp.input(0)\n    if util is None:\n        return None, '', 0\n    if frames is None:\n        first, last = int(grp\['first'\].value()), int(grp\['last'\].value())\n        if last < first:\n            first, last = last, first\n        probe = sorted(set(\[first, (first + last) // 2, last\]))\n        cams = \[camera_from_metadata(_metadata(util, f)) for f in probe\]\n        cams = \[c for c in cams if c\]\n        moving = len(cams) > 1 and not all(_same(_flat(c), _flat(cams\[0\])) for c in cams)\n        frames = list(range(first, last + 1)) if moving else probe\[:1\]\n    got, cams = \[\], \[\]\n    for f in frames:\n        c = camera_from_metadata(_metadata(util, f))\n        if c:\n            got.append(f)\n            cams.append(c)\n    if not cams:\n        return None, '', 0\n    for kname, field in VEC_KNOBS:\n        _set_knob(grp\[kname\], \[c\[field\] for c in cams\], got)\n    _set_knob(grp\['cam_th'\], \[c\['th'\] for c in cams\], got)\n    for kname, field in HDR_KNOBS:\n        _set_knob(grp\[kname\], \[c\[field\] or 0.0 for c in cams\], got)\n    lens = cams\[0\]\['lens'\]\n    for kname, field in LENS_KNOBS:\n        grp\[kname\].setValue(lens.get(field, 0) or 0)\n    sh = cams\[0\]\['shutter'\]\n    if sh and not grp\['rf_shutter_read'\].value():\n        if 'angle' in sh:\n            grp\['shutter'\].setValue(sh\['angle'\])\n        modes = ('backward', 'centred', 'forward')\n        if sh.get('mode') in modes:\n            grp\['shutter_mode'\].setValue(modes.index(sh\['mode'\]))\n        if sh.get('shape') in ('backwardsShape', 'box'):\n            grp\['shutter_shape'\].setValue(('backwardsShape', 'box').index(sh\['shape'\]))\n        grp\['rf_shutter_read'\].setValue(True)\n    src = cams\[0\]\['source'\]\n    grp\['rf_cam_src'\].setValue(json.dumps(dict(\n        frames=\[got\[0\], got\[-1\]\], n=len(got), pos=\[round(x, 4) for x in cams\[0\]\['pos'\]\], keys=sorted(set(src.values())),\n        range=\[int(grp\['first'\].value()), int(grp\['last'\].value())\])))\n    return cams\[0\], ('moving' if len(cams) > 1 else 'static'), len(cams)\n\n\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  Reading the node's own images: the surface under a point, the frame's facts\n# ---------------------------------------------------------------------------------------------------------------------\ndef _sample(node, x, y, chans='rgba'):\n    names = ('red', 'green', 'blue', 'alpha')\n    return \[node.sample(chans + '.' + c, x + 0.5, y + 0.5) for c in names\]\n\n\ndef _cam_now(grp):\n    return dict(pos=list(grp\['cam_pos'\].value()), right=list(grp\['cam_right'\].value()), up=list(grp\['cam_up'\].value()),\n                back=list(grp\['cam_back'\].value()), th=grp\['cam_th'\].value())\n\n\ndef _ray(cam, W, H, px, py):\n    tv = cam\['th'\] * H / float(W)\n    a = (px / W * 2 - 1) * cam\['th'\]\n    b = (py / H * 2 - 1) * tv\n    d = \[cam\['right'\]\[i\] * a + cam\['up'\]\[i\] * b - cam\['back'\]\[i\] for i in range(3)\]\n    return _unit(d)\n\n\ndef surface_point(grp, x, y):\n    \"\"\"The world point the camera sees at pixel (x, y) of the frame (Nuke's coordinates, y up), or None (sky).\"\"\"\n    surf = _inner(grp, 'rf_surface')\n    W, H = surf.width(), surf.height()\n    xi, yi = int(math.floor(x)), int(math.floor(y))\n    if xi < 0 or yi < 0 or xi >= W or yi >= H:\n        return None\n    dist, cov = _sample(surf, xi, yi)\[:2\]\n    if cov < 0.5 or dist <= 0:\n        return None\n    cam = _cam_now(grp)\n    d = _ray(cam, W, H, xi + 0.5, yi + 0.5)\n    return \[cam\['pos'\]\[k\] + d\[k\] * dist for k in range(3)\]\n\n\ndef aim_from_handle(grp):\n    \"\"\"Lands here was moved: aim the light at the point under it. Returns the point, or None (it is on the sky).\"\"\"\n    x, y = grp\['aim_xy'\].value()\n    P = surface_point(grp, x, y)\n    if P is not None:\n        grp\['aim'\].setValue(\[round(v, 4) for v in P\])\n        grp\['rf_aim_set'\].setValue(True)\n    status(grp, None if P is not None else 'Lands here is on the sky: drag it onto the set.')\n    return P\n\n\ndef aim_at_frame(grp):\n    \"\"\"A first aim: the set at the middle of the frame (or the nearest point below it that is not sky).\"\"\"\n    surf = _inner(grp, 'rf_surface')\n    W, H = surf.width(), surf.height()\n    for f in (0.5, 0.4, 0.3, 0.2, 0.1, 0.6, 0.7):\n        x, y = W * 0.5, H * f\n        if surface_point(grp, x, y) is not None:\n            grp\['aim_xy'\].setValue(\[x, y\])\n            return aim_from_handle(grp)\n    return None\n\n\ndef facts(grp):\n    \"\"\"What the facts kernel found out about the pass.\"\"\"\n    n = _inner(grp, 'rf_facts')\n    f0, f1, f2 = (_sample(n, x, 0) for x in range(3))\n    return dict(p_premult=f0\[0\] > 0.5, has_alpha=f0\[1\] > 0.5, has_p=f0\[2\] > 0.5, has_z=int(f0\[3\]) % 2 == 1,\n                has_zraw=f0\[3\] >= 2, z_view=f1\[0\] > 0.5, z_premult=f1\[1\] > 0.5, zraw_view=f1\[2\] > 0.5,\n                zraw_premult=f1\[3\] > 0.5, edge_samples=int(f2\[0\]), full_samples=int(f2\[1\]), samples=int(f2\[2\]))\n\n\ndef set_facts(grp):\n    \"\"\"The set's box and how far the haze reaches, from the frame kernel.\"\"\"\n    n = _inner(grp, 'rf_frame')\n    lo, hi = _sample(n, 0, 0), _sample(n, 1, 0)\n    return dict(lo=lo\[:3\], hi=hi\[:3\], points=int(lo\[3\]), reach=hi\[3\])\n\n\ndef sky_fraction(grp, nx=64, ny=36):\n    surf = _inner(grp, 'rf_surface')\n    W, H = surf.width(), surf.height()\n    sky = 0\n    for j in range(ny):\n        for i in range(nx):\n            d, c = _sample(surf, int((i + 0.5) * W / nx), int((j + 0.5) * H / ny))\[:2\]\n            if c <= 0.02 or d <= 0:\n                sky += 1\n    return sky / float(nx * ny)\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  The cuc input\n# ---------------------------------------------------------------------------------------------------------------------\ndef cuc_changed(grp):\n    \"\"\"Notes whether a cuc is connected, and its shape (the node stretches it to a square inside, then undoes it).\"\"\"\n    c = grp.input(2)\n    has = 1 if c is not None else 0\n    aspect = 1.0\n    if c is not None:\n        try:\n            w, h = float(c.width()), float(c.height())\n            if w > 0 and h > 0:\n                aspect = w / h\n        except Exception:\n            pass\n    if grp\['rf_has_cuc'\].value() != has:\n        grp\['rf_has_cuc'\].setValue(has)\n    if abs(grp\['rf_cuc_aspect'\].value() - aspect) > 1e-9:\n        grp\['rf_cuc_aspect'\].setValue(aspect)\n    return has, aspect\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  Check shot and the status line\n# ---------------------------------------------------------------------------------------------------------------------\ndef check(grp):\n    \"\"\"A report on the shot: \[(level, title, detail)\], level 'ok', 'note', 'warn' or 'problem'.\"\"\"\n    out = \[\]\n    if grp.input(0) is None:\n        return \[('problem', 'No utility pass', 'Connect the Read of the utility pass to the utility input.')\]\n    found = detect_layers(grp, force=False)\n    names = dict(P='position', N='normals', Z='depth', Zraw='unfiltered depth', A='coverage')\n    have = ', '.join('%s (%s)' % (names\[r\], found\[r\]) for r in ('P', 'N', 'Z', 'Zraw', 'A') if found.get(r))\n    out.append(('ok' if found.get('P') or found.get('Z') or found.get('Zraw') else 'problem', 'Layers',\n                have or 'No position or depth layer found. Pick them on the Shot tab.'))\n    if not found.get('Zraw'):\n        out.append(('note', 'Holdouts', 'No unfiltered depth layer found: holding out with the filtered depth or the '\n                    'positions, which are soft at edges.'))\n    if not found.get('N'):\n        out.append(('note', 'Normals', 'No normals layer: Light on set shows the light without the surfaces\\' '\n                    'facing.'))\n    try:\n        src = json.loads(grp\['rf_cam_src'\].value() or '\{\}')\n    except ValueError:\n        src = \{\}\n    if src.get('n'):\n        out.append(('ok', 'Camera', 'From the pass header on %d frame(s) (%s).' % (src\['n'\], ', '.join(src.get('keys', \[\])\[:6\]))))\n    else:\n        out.append(('problem', 'Camera', 'No camera found in the pass header. Press Read camera, or check the pass '\n                    'has the camera matrices in its header.'))\n    try:\n        fa = facts(grp)\n        how = \['positions %s by coverage' % ('premultiplied' if fa\['p_premult'\] else 'not premultiplied')\]\n        if fa\['has_z'\]:\n            how.append('depth along the %s%s' % ('view axis' if fa\['z_view'\] else 'ray',\n                                                  ', premultiplied' if fa\['z_premult'\] else ''))\n        if fa\['has_zraw'\]:\n            how.append('unfiltered depth along the %s' % ('view axis' if fa\['zraw_view'\] else 'ray'))\n        out.append(('ok' if fa\['has_alpha'\] else 'note', 'The pass',\n                    '; '.join(how) + ('' if fa\['has_alpha'\] else '; no coverage (alpha): taken as 1 wherever there is data')))\n    except Exception as exc:\n        out.append(('warn', 'The pass', 'Could not read it yet (%s).' % exc))\n    su = UNITS\[_idx(grp\['units'\])\]\n    try:\n        sf = set_facts(grp)\n        size = \[(sf\['hi'\]\[k\] - sf\['lo'\]\[k\]) * su for k in range(3)\]\n        if max(size) > 500 or max(size) < 0.1:\n            out.append(('warn', 'Scene units', 'The set is %.3g x %.3g x %.3g m in %s: check Scene units.' %\n                        (size\[0\], size\[1\], size\[2\], grp\['units'\].value())))\n        else:\n            out.append(('ok', 'The set', '%.3g x %.3g x %.3g m; the haze reaches %.3g m from the camera.' %\n                        (size\[0\], size\[1\], size\[2\], sf\['reach'\] * su)))\n    except Exception:\n        pass\n    sky = None\n    try:\n        sky = sky_fraction(grp)\n    except Exception:\n        pass\n    if not grp\['rf_aim_set'\].value():\n        out.append(('warn', 'Aim', 'The light is not aimed yet: drag Lands here onto the set in the viewer.'))\n    else:\n        a = grp\['aim'\].value()\n        out.append(('ok', 'Aim', 'The light lands at (%.4g, %.4g, %.4g).' % (a\[0\], a\[1\], a\[2\])))\n    if sky is not None:\n        interior = grp\['interior'\].value()\n        if sky < 0.6 and not interior:\n            out.append(('note', 'Openings', '%d%% of the frame is sky. If this is a room and light comes in through '\n                        'walls the camera cannot see, turn on Light only through openings (Shadows, on the More '\n                        'tab).' % int(round(sky * 100))))\n        elif interior and sky == 0:\n            out.append(('warn', 'Openings', 'Light only through openings is on, but the camera sees no sky or '\n                        'opening: no light can get in. Turn it off, or paint the window into a cuc.'))\n    has, aspect = cuc_changed(grp)\n    if has and grp\['cuc_on'\].value():\n        out.append(('ok', 'Cuc', 'From the cuc input (%s, %.3g:1).' % (grp\['cuc_from'\].value(), aspect)))\n    return out\n\n\ndef report_html(items):\n    col = dict(ok='#7c7', note='#9bd', warn='#eb6', problem='#e77')\n    return '<br>'.join('<span style=\"color:%s\">%s</span> <b>%s</b>: %s' % (col\[l\], l.upper(), t, d.replace('<', '&lt;'))\n                       for l, t, d in items)\n\n\ndef status(grp, msg=None):\n    try:\n        src = json.loads(grp\['rf_cam_src'\].value() or '\{\}')\n    except ValueError:\n        src = \{\}\n    bits = \[\]\n    if grp.input(0) is None:\n        bits.append('connect the utility pass to the <b>utility</b> input')\n    else:\n        bits.append('camera from the pass' if src.get('n') else\n                    '<span style=\"color:#e77\">no camera yet: press Read camera</span>')\n        bits.append(('sun', 'spot')\[_idx(grp\['light_type'\])\] +\n                    ('' if grp\['rf_aim_set'\].value() else ' (drag <b>Lands here</b> onto the set)'))\n        if grp\['rf_has_cuc'\].value() and grp\['cuc_on'\].value():\n            bits.append('cuc')\n    if msg:\n        bits.append('<span style=\"color:#eb6\">%s</span>' % msg)\n    grp\['rf_status'\].setValue(' &middot; '.join(bits))\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  Events\n# ---------------------------------------------------------------------------------------------------------------------\ndef connected(grp):\n    \"\"\"The utility input was connected: layers, frame range, camera, and a first aim.\"\"\"\n    util = grp.input(0)\n    if util is None:\n        return\n    detect_layers(grp, force=True)\n    try:\n        f0, f1 = int(util.firstFrame()), int(util.lastFrame())\n        if (int(grp\['first'\].value()), int(grp\['last'\].value())) == (1001, 1048) and f1 >= f0:\n            grp\['first'\].setValue(f0)\n            grp\['last'\].setValue(f1)\n    except Exception:\n        pass\n    cam, how, n = read_camera(grp)\n    if cam is not None and not grp\['rf_aim_set'\].value():\n        try:\n            aim_at_frame(grp)\n        except Exception:\n            pass\n    status(grp)\n\n\ndef button(grp, which):\n    if which == 'read_camera':\n        cam, how, n = read_camera(grp)\n        if cam is None:\n            nuke.message('%s: no camera found in the header of the utility pass.' % NAME)\n        status(grp)\n    elif which == 'check_shot':\n        items = check(grp)\n        grp\['rf_report'\].setValue(report_html(items))\n    elif which == 'find_layers':\n        detect_layers(grp, force=True)\n        status(grp)\n    elif which == 'repair':\n        bad = setup(grp)\n        cuc_changed(grp)\n        nuke.message('%s: ' % NAME + ('everything is linked.' if not bad else 'could not link: %s' % bad))\n\n\ndef camera_changed(grp):\n    \"\"\"True when the pass's header no longer says what the camera knobs were read from (a new version of the pass,\n    or a new frame range).\"\"\"\n    util = grp.input(0)\n    if util is None:\n        return False\n    try:\n        src = json.loads(grp\['rf_cam_src'\].value() or '\{\}')\n    except ValueError:\n        src = \{\}\n    if not src.get('n'):\n        return False\n    if src.get('range') and src\['range'\] != \[int(grp\['first'\].value()), int(grp\['last'\].value())\]:\n        return True\n    c = camera_from_metadata(_metadata(util, src\['frames'\]\[0\]))\n    return c is not None and not _same(\[round(x, 4) for x in c\['pos'\]\], src\['pos'\])\n\n\ndef created(grp):\n    \"\"\"The node was made (pasted, or its script opened): wire and link it; if it arrived already connected to a pass\n    it has not read yet, read it.\"\"\"\n    setup(grp)\n    cuc_changed(grp)\n    if grp.input(0) is not None and not grp\['rf_cam_src'\].value():\n        connected(grp)\n    else:\n        status(grp)\n\n\ndef knob_changed(grp, knob):\n    name = knob.name() if knob is not None else ''\n    if name == 'inputChange':\n        cuc_changed(grp)\n        if grp.input(0) is not None and not grp\['rf_cam_src'\].value():\n            connected(grp)\n        else:\n            status(grp)\n    elif name == 'showPanel':\n        if grp\['rf_version'\].value() != VERSION:\n            setup(grp)\n        cuc_changed(grp)\n        if camera_changed(grp):\n            read_camera(grp)\n        status(grp)\n    elif name == 'aim_xy':\n        aim_from_handle(grp)\n    elif name in ('light_type', 'cuc_on', 'units'):\n        status(grp)\n"
}
Input {
 inputs 0
 name cuc
 number 2
 xpos 700
 ypos -900
}
set Ncuc [stack 0]
Input {
 inputs 0
 name plate
 number 1
 xpos 1000
 ypos -900
}
set Nplate [stack 0]
Input {
 inputs 0
 name utility
 xpos 0
 ypos -900
}
set Nutility [stack 0]
Crop {
 box {0 0 {{input.width}} {{input.height}}}
 crop true
 name rf_fmt
 xpos 0
 ypos -840
}
set Nrf_fmt [stack 0]
Shuffle {
 in none
 in2 rgba
 red red
 green green
 blue blue
 alpha alpha2
 name rf_pos
 xpos 0
 ypos -780
}
set Nrf_pos [stack 0]
push $Nrf_fmt
Shuffle {
 in none
 in2 none
 red red
 green red2
 blue black
 alpha black
 name rf_depth
 xpos 120
 ypos -780
}
set Nrf_depth [stack 0]
push $Nrf_fmt
Shuffle {
 in none
 in2 none
 red red
 green green
 blue blue
 alpha black
 name rf_nrm
 xpos 240
 ypos -780
}
set Nrf_nrm [stack 0]
push $Ncuc
Shuffle {
 in rgba
 in2 none
 red alpha
 green alpha
 blue alpha
 alpha alpha
 name rf_cuc_a
 xpos 800
 ypos -840
}
set Nrf_cuc_a [stack 0]
push $Nrf_cuc_a
push $Ncuc
Switch {
 inputs 2
 which {{parent.cuc_from}}
 name rf_cuc_from
 xpos 700
 ypos -780
}
set Nrf_cuc_from [stack 0]
Reformat {
 format "1024 1024 0 0 1024 1024 1 rf_cuc_square"
 resize distort
 name rf_cuc_sq
 xpos 700
 ypos -720
}
set Nrf_cuc_sq [stack 0]
Blur {
 size {{parent.cuc_soft*10.24}}
 name rf_cuc_soft
 xpos 700
 ypos -660
}
set Nrf_cuc_soft [stack 0]
Crop {
 box {0 0 1024 1024}
 crop true
 name rf_cuc
 xpos 700
 ypos -600
}
set Nrf_cuc [stack 0]
push $Nrf_depth
push $Nrf_pos
Constant {
 inputs 0
 channels rgba
 color {0 0 0 0}
 format "3 1 0 0 3 1 1 rf_space_facts_fmt"
 name rf_space_facts
 xpos -250
 ypos -600
}
set Nrf_space_facts [stack 0]
BlinkScript {
 inputs 3
 kernelSource "// RayField: facts about the utility pass, from a grid of samples (4 x 1 pixels out):\n//   pixel 0: position premultiplied by coverage (1/0), alpha present, position present, depth present + 2 x unfiltered depth present\n//   pixel 1: depth along the view axis (1) or the ray (0), depth premultiplied, the same two for the unfiltered depth\n//   pixel 2: edge samples, fully covered samples, samples, 0\n// Mirrors shot.build_surface in the Python reference: premultiplication is found by reprojecting edge pixels.\nkernel RFFacts : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> pos;\n  Image<eRead, eAccessRandom, eEdgeClamped> depth;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n  local:\n    float Wf;\n    float Hf;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  void init() \{\n    Wf = float(pos.bounds.width());\n    Hf = float(pos.bounds.height());\n  \}\n\n  float reproj(float3 P, float px, float py) \{\n    float3 p = project_mid(P);\n    if (p.z <= 0.0f) \{\n      return 1e9f;\n    \}\n    float dx = p.x - px;\n    float dy = p.y - py;\n    return sqrt(dx * dx + dy * dy);\n  \}\n\n  void process(int2 xy) \{\n    int x0 = pos.bounds.x1;\n    int y0 = pos.bounds.y1;\n    int gx = 160;\n    int gy = 90;\n    float has_a = 0.0f;\n    float has_p = 0.0f;\n    float has_z = 0.0f;\n    float has_zr = 0.0f;\n    float n_edge = 0.0f;\n    float n_full = 0.0f;\n    float votes = 0.0f;\n    for (int j = 0; j < gy; j++) \{\n      for (int i = 0; i < gx; i++) \{\n        int sx = x0 + int((float(i) + 0.5f) * Wf / float(gx));\n        int sy = y0 + int((float(j) + 0.5f) * Hf / float(gy));\n        float4 p = pos(sx, sy);\n        float4 z = depth(sx, sy);\n        float3 P = float3(p.x, p.y, p.z);\n        if (p.w > 0.0f) \{\n          has_a = 1.0f;\n        \}\n        if (fabs(p.x) + fabs(p.y) + fabs(p.z) > 0.0f) \{\n          has_p = 1.0f;\n        \}\n        if (z.x > 0.0f) \{\n          has_z = 1.0f;\n        \}\n        if (z.y > 0.0f) \{\n          has_zr = 1.0f;\n        \}\n        if (p.w >= 0.98f) \{\n          n_full += 1.0f;\n        \}\n        if (p.w > 0.02f && p.w < 0.98f) \{\n          n_edge += 1.0f;\n          float px = float(sx) + 0.5f;\n          float py = float(sy) + 0.5f;\n          float e_raw = reproj(P, px, py);\n          float e_div = reproj(P / max(p.w, 1e-6f), px, py);\n          if (e_div < e_raw) \{\n            votes += 1.0f;\n          \}\n        \}\n      \}\n    \}\n    float premult = (n_edge >= 20.0f && votes > 0.5f * n_edge) ? 1.0f : 0.0f;\n    if (xy.x == 0) \{\n      dst() = float4(premult, has_a, has_p, has_z + 2.0f * has_zr);\n      return;\n    \}\n    if (xy.x == 2) \{\n      dst() = float4(n_edge, n_full, float(gx * gy), 0.0f);\n      return;\n    \}\n    if (xy.x != 1 || has_p == 0.0f) \{\n      dst() = float4(0.0f);\n      return;\n    \}\n    // depth: along the ray or the view axis, and premultiplied or not (checked against the positions)\n    float zk_n = 0.0f;\n    float zk_v = 0.0f;\n    float zp_n = 0.0f;\n    float zp_v = 0.0f;\n    float rk_n = 0.0f;\n    float rk_v = 0.0f;\n    float rp_n = 0.0f;\n    float rp_v = 0.0f;\n    for (int j = 0; j < gy; j++) \{\n      for (int i = 0; i < gx; i++) \{\n        int sx = x0 + int((float(i) + 0.5f) * Wf / float(gx));\n        int sy = y0 + int((float(j) + 0.5f) * Hf / float(gy));\n        float4 p = pos(sx, sy);\n        float4 z = depth(sx, sy);\n        float cov = has_a > 0.0f ? clamp(p.w, 0.0f, 1.0f) : 1.0f;\n        float3 P = float3(p.x, p.y, p.z);\n        if (premult > 0.0f) \{\n          P = P / max(cov, 1e-6f);\n        \}\n        if (fabs(p.x) + fabs(p.y) + fabs(p.z) <= 0.0f) \{\n          continue;\n        \}\n        float ray = len3(P - cam_pos);\n        if (ray <= 0.0f) \{\n          continue;\n        \}\n        float cosang = fabs(dot(ray_dir(float(sx) + 0.5f, float(sy) + 0.5f), cam_back));\n        if (cov >= 0.98f) \{\n          if (z.x > 0.0f) \{\n            zk_n += 1.0f;\n            if (fabs(z.x / (ray * cosang) - 1.0f) < fabs(z.x / ray - 1.0f)) \{\n              zk_v += 1.0f;\n            \}\n          \}\n          if (z.y > 0.0f) \{\n            rk_n += 1.0f;\n            if (fabs(z.y / (ray * cosang) - 1.0f) < fabs(z.y / ray - 1.0f)) \{\n              rk_v += 1.0f;\n            \}\n          \}\n        \}\n      \}\n    \}\n    float zview = (zk_n >= 20.0f && zk_v > 0.5f * zk_n) ? 1.0f : 0.0f;\n    float rview = (rk_n >= 20.0f && rk_v > 0.5f * rk_n) ? 1.0f : 0.0f;\n    for (int j = 0; j < gy; j++) \{\n      for (int i = 0; i < gx; i++) \{\n        int sx = x0 + int((float(i) + 0.5f) * Wf / float(gx));\n        int sy = y0 + int((float(j) + 0.5f) * Hf / float(gy));\n        float4 p = pos(sx, sy);\n        float4 z = depth(sx, sy);\n        if (!(has_a > 0.0f && p.w > 0.02f && p.w < 0.98f)) \{\n          continue;\n        \}\n        float cov = p.w;\n        float3 P = float3(p.x, p.y, p.z);\n        if (premult > 0.0f) \{\n          P = P / cov;\n        \}\n        float ray = len3(P - cam_pos);\n        if (ray <= 0.0f) \{\n          continue;\n        \}\n        float cosang = max(fabs(dot(ray_dir(float(sx) + 0.5f, float(sy) + 0.5f), cam_back)), 1e-6f);\n        if (z.x > 0.0f) \{\n          float d = zview > 0.0f ? z.x / cosang : z.x;\n          zp_n += 1.0f;\n          if (fabs(d / cov / ray - 1.0f) < fabs(d / ray - 1.0f)) \{\n            zp_v += 1.0f;\n          \}\n        \}\n        if (z.y > 0.0f) \{\n          float d = rview > 0.0f ? z.y / cosang : z.y;\n          rp_n += 1.0f;\n          if (fabs(d / cov / ray - 1.0f) < fabs(d / ray - 1.0f)) \{\n            rp_v += 1.0f;\n          \}\n        \}\n      \}\n    \}\n    float zpre = (zp_n >= 20.0f && zp_v > 0.5f * zp_n) ? 1.0f : 0.0f;\n    float rpre = (rp_n >= 20.0f && rp_v > 0.5f * rp_n) ? 1.0f : 0.0f;\n    dst() = float4(zview, zpre, rview, rpre);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name rf_facts
 onCreate "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _rf(_g).link_kernel(_g, 'rf_facts')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -600
}
set Nrf_facts [stack 0]
push $Nrf_facts
push $Nrf_depth
push $Nrf_pos
BlinkScript {
 inputs 3
 kernelSource "// RayField: what each pixel sees, made safe to use (mirrors shot.build_surface in the Python reference):\n//   r = distance from the camera to the surface for holdouts (unfiltered depth if there is one; 0 = nothing there)\n//   g = coverage 0..1\n//   b = distance to the surface from the position pass (or the depth), for shadows and bounce light\n//   a = 1 where one surface fills the pixel (safe to use as a 3D point), else 0\nkernel RFSurface : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> pos;\n  Image<eRead, eAccessRandom, eEdgeClamped> depth;\n  Image<eRead, eAccessRandom, eEdgeClamped> facts;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n    int p_premult;\n    int z_kind;\n    int z_premult;\n  local:\n    float Wf;\n    float Hf;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n    defineParam(p_premult, \"p_premult\", -1);\n    defineParam(z_kind, \"z_kind\", -1);\n    defineParam(z_premult, \"z_premult\", -1);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  void init() \{\n    Wf = float(pos.bounds.width());\n    Hf = float(pos.bounds.height());\n  \}\n\n  // coverage and distance along the ray from the position pass at a pixel (0 where empty)\n  float2 cov_ray(int x, int y, float has_a, float premult) \{\n    float4 p = pos(x, y);\n    float4 z = depth(x, y);\n    bool have = fabs(p.x) + fabs(p.y) + fabs(p.z) > 0.0f || z.x > 0.0f || z.y > 0.0f;\n    float cov = has_a > 0.0f ? clamp(p.w, 0.0f, 1.0f) : (have ? 1.0f : 0.0f);\n    if (cov <= 0.0f || fabs(p.x) + fabs(p.y) + fabs(p.z) <= 0.0f) \{\n      return float2(cov, 0.0f);\n    \}\n    float3 P = float3(p.x, p.y, p.z);\n    if (premult > 0.0f) \{\n      P = P / max(cov, 1e-6f);\n    \}\n    return float2(cov, len3(P - cam_pos));\n  \}\n\n  void process(int2 xy) \{\n    float4 f0 = facts(0, 0);\n    float4 f1 = facts(1, 0);\n    float has_a = f0.y;\n    float has_p = f0.z;\n    float has_z = fmod(f0.w, 2.0f);\n    float has_zr = f0.w >= 2.0f ? 1.0f : 0.0f;\n    float premult = p_premult >= 0 ? float(p_premult) : f0.x;\n    float zview = z_kind >= 0 ? float(z_kind) : f1.x;\n    float rview = z_kind >= 0 ? float(z_kind) : f1.z;\n    float zpre = z_premult >= 0 ? float(z_premult) : f1.y;\n    float rpre = z_premult >= 0 ? float(z_premult) : f1.w;\n    if (has_p == 0.0f) \{\n      zpre = 0.0f;\n      rpre = 0.0f;\n      if (z_kind < 0) \{\n        zview = 0.0f;\n        rview = 0.0f;\n      \}\n    \}\n    float2 cr = cov_ray(xy.x, xy.y, has_a, premult);\n    float cov = cr.x;\n    float ray = cr.y;\n    float4 z = depth(xy.x, xy.y);\n    float cosang = max(fabs(dot(ray_dir(float(xy.x) + 0.5f, float(xy.y) + 0.5f), cam_back)), 1e-6f);\n    float zd = 0.0f;\n    float rd = 0.0f;\n    if (cov > 0.0f) \{\n      zd = max(z.x, 0.0f);\n      rd = max(z.y, 0.0f);\n      if (zview > 0.0f) \{\n        zd = zd / cosang;\n      \}\n      if (rview > 0.0f) \{\n        rd = rd / cosang;\n      \}\n      if (zpre > 0.0f) \{\n        zd = zd / max(cov, 1e-6f);\n      \}\n      if (rpre > 0.0f) \{\n        rd = rd / max(cov, 1e-6f);\n      \}\n    \}\n    float dist = has_zr > 0.0f ? rd : (has_z > 0.0f ? zd : (cov > 0.0f ? ray : 0.0f));\n    if (has_p == 0.0f) \{\n      ray = dist;\n    \}\n    // clean: fully covered by one surface (not mixed per the unfiltered depth, no depth jump to a neighbour)\n    float clean = (cov >= 0.98f && ray > 0.0f) ? 1.0f : 0.0f;\n    if (clean > 0.0f && has_zr > 0.0f && has_p > 0.0f && fabs(rd - ray) > 0.02f * max(ray, 1e-6f)) \{\n      clean = 0.0f;\n    \}\n    if (clean > 0.0f && has_p > 0.0f) \{\n      for (int dy = -1; dy <= 1; dy++) \{\n        for (int dx = -1; dx <= 1; dx++) \{\n          int nx = xy.x + dx;\n          int ny = xy.y + dy;\n          if ((dx == 0 && dy == 0) || nx < pos.bounds.x1 || ny < pos.bounds.y1 || nx >= pos.bounds.x2 || ny >= pos.bounds.y2) \{\n            continue;\n          \}\n          float rn = cov_ray(nx, ny, has_a, premult).y;\n          if (fabs(rn - ray) > 0.04f * max(min(rn, ray), 1e-6f)) \{\n            clean = 0.0f;\n          \}\n        \}\n      \}\n    \}\n    dst() = float4(dist, cov, ray, clean);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name rf_surface
 onCreate "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _rf(_g).link_kernel(_g, 'rf_surface')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -540
}
set Nrf_surface [stack 0]
push $Nrf_surface
Constant {
 inputs 0
 channels rgba
 color {0 0 0 0}
 format "4 1 0 0 4 1 1 rf_space_frame_fmt"
 name rf_space_frame
 xpos -250
 ypos -480
}
set Nrf_space_frame [stack 0]
BlinkScript {
 inputs 2
 kernelSource "// RayField: a few numbers about the set and the light, from a grid of samples of the surface image (4 x 1 out):\n//   pixel 0: the set's box (the camera and the clean surface the haze reaches): min x y z, and how many\n//            samples were in it\n//   pixel 1: the box's max x y z, and how far the haze reaches (scene units)\n//   pixel 2: the sun's light-map frame: u0, v0 and the size of one light-map pixel (scene units)\n// Mirrors reference.frame.\nkernel RFFrame : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n    int light_type;\n    float3 aim;\n    float light_az;\n    float light_el;\n    float roll;\n    float light_dist;\n    float cone;\n    float su;\n    float reach;\n    int lm_n;\n  local:\n    float Wf;\n    float Hf;\n    float3 Lfwd;\n    float3 Lright;\n    float3 Lup;\n    float3 Ltoward;\n    float3 Lpos;\n    float tanc;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n    defineParam(light_type, \"light_type\", 0);\n    defineParam(aim, \"aim\", float3(0.0f, 0.0f, 0.0f));\n    defineParam(light_az, \"light_az\", 25.0f);\n    defineParam(light_el, \"light_el\", 33.0f);\n    defineParam(roll, \"roll\", 0.0f);\n    defineParam(light_dist, \"light_dist\", 4.0f);\n    defineParam(cone, \"cone\", 40.0f);\n    defineParam(su, \"su\", 0.01f);\n    defineParam(reach, \"reach\", 0.0f);\n    defineParam(lm_n, \"lm_n\", 1024);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  // ---- the light (mirrors rayfield/lightmath.py)\n  // Needs params light_type aim light_az light_el roll distance cone su, and locals\n  // Lfwd Lright Lup Ltoward Lpos tanc (set by light_setup() in init()).\n  float3 kelvin_rgb(float K) \{\n    float t = K / 100.0f;\n    float r = 255.0f;\n    float g = 0.0f;\n    float b = 255.0f;\n    if (t <= 66.0f) \{\n      g = 99.4708025861f * log(t) - 161.1195681661f;\n    \} else \{\n      r = 329.698727446f * pow(t - 60.0f, -0.1332047592f);\n      g = 288.1221695283f * pow(t - 60.0f, -0.0755148492f);\n    \}\n    if (t < 66.0f) \{\n      if (t <= 19.0f) \{\n        b = 0.0f;\n      \} else \{\n        b = 138.5177312231f * log(t - 10.0f) - 305.0447927307f;\n      \}\n    \}\n    float3 c = float3(pow(clamp(r, 0.0f, 255.0f) / 255.0f, 2.2f), pow(clamp(g, 0.0f, 255.0f) / 255.0f, 2.2f),\n                      pow(clamp(b, 0.0f, 255.0f) / 255.0f, 2.2f));\n    return c / (0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z);\n  \}\n  // unit vector toward the light (Y up); heading 0 = the light travels toward +X\n  float3 light_dir(float az, float el) \{\n    float a = az * 0.0174532925f;\n    float e = el * 0.0174532925f;\n    return float3(-cos(a) * cos(e), sin(e), -sin(a) * cos(e));\n  \}\n  void light_setup() \{\n    Ltoward = light_dir(light_az, light_el);\n    Lfwd = Ltoward * -1.0f;\n    float3 ref = fabs(Lfwd.y) < 0.999f ? float3(0.0f, 1.0f, 0.0f) : float3(0.0f, 0.0f, -1.0f);\n    float3 r0 = unit3(cross(Lfwd, ref));\n    float3 u0 = cross(r0, Lfwd);\n    float ca = cos(roll * 0.0174532925f);\n    float sa = sin(roll * 0.0174532925f);\n    Lright = r0 * ca + u0 * sa;\n    Lup = u0 * ca - r0 * sa;\n    Lpos = aim + Ltoward * (light_dist / su);\n    tanc = tan(clamp(cone, 1.0f, 170.0f) * 0.5f * 0.0174532925f);\n  \}\n  // light-space coordinates of a world point: (lu, lv, lt, valid).\n  // sun: lu, lv across the light from the aim point (scene units), lt along it.\n  // spot: lu, lv in the cone (-1..1 at its edge), lt = distance from the light.\n  float4 light_coords(float3 X) \{\n    if (light_type == 0) \{\n      float3 q = X - aim;\n      return float4(dot(q, Lright), dot(q, Lup), dot(q, Lfwd), 1.0f);\n    \}\n    float3 q = X - Lpos;\n    float z = dot(q, Lfwd);\n    if (z <= 1e-6f) \{\n      return float4(0.0f, 0.0f, len3(q), 0.0f);\n    \}\n    float zs = z * tanc;\n    return float4(dot(q, Lright) / zs, dot(q, Lup) / zs, len3(q), 1.0f);\n  \}\n  // Henyey-Greenstein, 1 everywhere at g = 0\n  float hg(float c, float g) \{\n    return (1.0f - g * g) / pow(max(1.0f + g * g - 2.0f * g * c, 1e-4f), 1.5f);\n  \}\n  void init() \{\n    Wf = float(surf.bounds.width());\n    Hf = float(surf.bounds.height());\n    light_setup();\n  \}\n\n  void process(int2 xy) \{\n    int x0 = surf.bounds.x1;\n    int y0 = surf.bounds.y1;\n    // how far the set goes: the 95th percentile of the distances the camera sees (by bisection)\n    int gx = 96;\n    int gy = 54;\n    float maxd = 0.0f;\n    float n = 0.0f;\n    for (int j = 0; j < gy; j++) \{\n      for (int i = 0; i < gx; i++) \{\n        int sx = x0 + int((float(i) + 0.5f) * Wf / float(gx));\n        int sy = y0 + int((float(j) + 0.5f) * Hf / float(gy));\n        float4 s = surf(sx, sy);\n        if (s.y >= 0.5f && s.x > 0.0f) \{\n          maxd = max(maxd, s.x);\n          n += 1.0f;\n        \}\n      \}\n    \}\n    float autor = 20.0f / su;\n    if (n > 0.0f) \{\n      float lo = 0.0f;\n      float hi = maxd;\n      for (int it = 0; it < 14; it++) \{\n        float mid = 0.5f * (lo + hi);\n        float c = 0.0f;\n        for (int j = 0; j < gy; j++) \{\n          for (int i = 0; i < gx; i++) \{\n            int sx = x0 + int((float(i) + 0.5f) * Wf / float(gx));\n            int sy = y0 + int((float(j) + 0.5f) * Hf / float(gy));\n            float4 s = surf(sx, sy);\n            if (s.y >= 0.5f && s.x > 0.0f && s.x <= mid) \{\n              c += 1.0f;\n            \}\n          \}\n        \}\n        if (c >= 0.95f * n) \{\n          hi = mid;\n        \} else \{\n          lo = mid;\n        \}\n      \}\n      autor = max(hi * 1.15f, 1.0f / su);\n    \}\n    float rch = reach > 0.0f ? reach / su : autor;\n    if (xy.x == 3) \{\n      dst() = float4(0.0f);\n      return;\n    \}\n    // the box of the set, and the light-space extent of everything the camera's rays cross\n    gx = 192;\n    gy = 108;\n    float3 lo3 = float3(1e30f);\n    float3 hi3 = float3(-1e30f);\n    float npts = 0.0f;\n    float umin = 1e30f;\n    float umax = -1e30f;\n    float vmin = 1e30f;\n    float vmax = -1e30f;\n    for (int j = 0; j < gy; j++) \{\n      for (int i = 0; i < gx; i++) \{\n        int sx = x0 + int((float(i) + 0.5f) * Wf / float(gx));\n        int sy = y0 + int((float(j) + 0.5f) * Hf / float(gy));\n        float4 s = surf(sx, sy);\n        float3 d = ray_dir(float(sx - x0) + 0.5f, float(sy - y0) + 0.5f);\n        bool inbox = s.y >= 0.5f && s.x > 0.0f && s.x <= rch;\n        float3 P = cam_pos + d * (inbox ? s.x : rch);\n        if (inbox) \{\n          lo3 = float3(min(lo3.x, P.x), min(lo3.y, P.y), min(lo3.z, P.z));\n          hi3 = float3(max(hi3.x, P.x), max(hi3.y, P.y), max(hi3.z, P.z));\n          npts += 1.0f;\n        \}\n        float3 q = P - aim;\n        float lu = dot(q, Lright);\n        float lv = dot(q, Lup);\n        umin = min(umin, lu);\n        umax = max(umax, lu);\n        vmin = min(vmin, lv);\n        vmax = max(vmax, lv);\n      \}\n    \}\n    float3 qc = cam_pos - aim;\n    umin = min(umin, dot(qc, Lright));\n    umax = max(umax, dot(qc, Lright));\n    vmin = min(vmin, dot(qc, Lup));\n    vmax = max(vmax, dot(qc, Lup));\n    if (npts < 1.0f) \{\n      lo3 = cam_pos - float3(5.0f / su);\n      hi3 = cam_pos + float3(5.0f / su);\n    \}\n    // the air the camera looks through is part of the set\n    lo3 = float3(min(lo3.x, cam_pos.x), min(lo3.y, cam_pos.y), min(lo3.z, cam_pos.z));\n    hi3 = float3(max(hi3.x, cam_pos.x), max(hi3.y, cam_pos.y), max(hi3.z, cam_pos.z));\n    if (xy.x == 0) \{\n      dst() = float4(lo3.x, lo3.y, lo3.z, npts);\n      return;\n    \}\n    if (xy.x == 1) \{\n      dst() = float4(hi3.x, hi3.y, hi3.z, rch);\n      return;\n    \}\n    float ext = max(max(umax - umin, vmax - vmin), 0.1f / su);\n    float s_raw = ext / float(lm_n - 4);\n    float stp = pow(2.0f, ceil(log(s_raw) / log(2.0f) * 4.0f) / 4.0f);\n    float u0 = (floor(umin / stp) - 1.0f) * stp;\n    float v0 = (floor(vmin / stp) - 1.0f) * stp;\n    dst() = float4(u0, v0, stp, 0.0f);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name rf_frame
 onCreate "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _rf(_g).link_kernel(_g, 'rf_frame')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -480
}
