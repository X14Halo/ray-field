set Nrf_low8 [stack 0]
BlinkScript {
 inputs 3
 kernelSource "// RayField: the frame at 1/8 of its size, for the openings: r = the farthest clean surface in each block of the\n// frame within the haze's reach, 0 where the block shows only sky or the far outside. Mirrors reference.blocks.\nkernel RFBlocks : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eRead, eAccessRandom, eEdgeClamped> info;\n  Image<eWrite> dst;\n\n  local:\n    int W;\n    int H;\n    int w;\n    int h;\n\n  void define() \{\n  \}\n\n  void init() \{\n    W = surf.bounds.width();\n    H = surf.bounds.height();\n    w = space.bounds.width();\n    h = space.bounds.height();\n  \}\n\n  void process(int2 xy) \{\n    float rch = info(info.bounds.x1 + 1, info.bounds.y1).w;\n    int cx = xy.x - space.bounds.x1;\n    int cy = xy.y - space.bounds.y1;\n    int x0 = (cx * W) / w;\n    int x1 = max(((cx + 1) * W) / w, x0 + 1);\n    int y0 = (cy * H) / h;\n    int y1 = max(((cy + 1) * H) / h, y0 + 1);\n    float d = 0.0f;\n    for (int y = y0; y < y1; y++) \{\n      for (int x = x0; x < x1; x++) \{\n        float4 s = surf(surf.bounds.x1 + x, surf.bounds.y1 + y);\n        if (s.y >= 0.5f && s.x > 0.0f && s.x <= rch) \{\n          d = max(d, s.x);\n        \}\n      \}\n    \}\n    dst() = float4(d, 0.0f, 0.0f, 0.0f);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name rf_blocks
 onCreate "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _rf(_g).link_kernel(_g, 'rf_blocks')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -420
}
set Nrf_blocks [stack 0]
push $Nrf_blocks
BlinkScript {
 inputs 1
 kernelSource "// RayField: how far away the openings are (windows, doors, gaps to the sky), at 1/8 of the frame's size. Where a\n// block shows surface, r = its depth (from the blocks image); where it shows only sky or the far outside, r is filled\n// in from the nearest blocks with surface around it (in 8 directions, weighted by 1 / distance), so it is roughly\n// the depth of the window's plane. g = 1 where r is known. The light map uses it to tell air outside a window\n// (beyond r: light there has come in through the opening) from air in front of it. Mirrors reference.openings.\nkernel RFOpenings : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> blocks;\n  Image<eWrite> dst;\n\n  local:\n    int w;\n    int h;\n\n  void define() \{\n  \}\n\n  void init() \{\n    w = blocks.bounds.width();\n    h = blocks.bounds.height();\n  \}\n\n  void process(int2 xy) \{\n    int bx = blocks.bounds.x1;\n    int by = blocks.bounds.y1;\n    int cx = xy.x - bx;\n    int cy = xy.y - by;\n    float d = blocks(xy.x, xy.y).x;\n    if (d > 0.0f) \{\n      dst() = float4(d, 1.0f, 0.0f, 0.0f);\n      return;\n    \}\n    float acc = 0.0f;\n    float wsum = 0.0f;\n    for (int dir = 0; dir < 8; dir++) \{\n      int dx = (dir == 0 || dir == 4 || dir == 5) ? 1 : ((dir == 1 || dir == 6 || dir == 7) ? -1 : 0);\n      int dy = (dir == 2 || dir == 4 || dir == 6) ? 1 : ((dir == 3 || dir == 5 || dir == 7) ? -1 : 0);\n      float stp = (dx != 0 && dy != 0) ? 1.41421356f : 1.0f;\n      for (int k = 1; k < 4096; k++) \{\n        int x = cx + dx * k;\n        int y = cy + dy * k;\n        if (x < 0 || y < 0 || x >= w || y >= h) \{\n          break;\n        \}\n        float dd = blocks(bx + x, by + y).x;\n        if (dd > 0.0f) \{\n          float wt = 1.0f / (float(k) * stp);\n          acc += dd * wt;\n          wsum += wt;\n          break;\n        \}\n      \}\n    \}\n    dst() = wsum > 0.0f ? float4(acc / wsum, 1.0f, 0.0f, 0.0f) : float4(0.0f);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name rf_openings
 onCreate "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _rf(_g).link_kernel(_g, 'rf_openings')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -360
}
