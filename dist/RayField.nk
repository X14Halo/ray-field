set Nrf_space_lightmap [stack 0]
BlinkScript {
 inputs 4
 kernelSource "// RayField: the light map, the set as the light sees it. For each light-map pixel, the light ray through it is\n// marched through the set's box; a step that lands just behind a surface the camera sees (by less than Thickness)\n// is where something blocks the light. Out:\n//   r = how far the light gets along its ray before it is blocked (1e20 = it never is)\n//   g = where the ray enters the set's box (1e20 = it misses the set)\n//   b = 1 where light got into the set along this ray (through an opening, with 'Light only through openings')\n// Only the first lm_n x lm_n pixels are used (the rest are left empty).\n// Sun: lt is the distance along the light from the aim point's plane; spot: the distance from the light.\n// Mirrors reference.lightmap.\nkernel RFLightMap : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eRead, eAccessRandom, eEdgeClamped> info;\n  Image<eRead, eAccessRandom, eEdgeClamped> opn;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n    int light_type;\n    float3 aim;\n    float light_az;\n    float light_el;\n    float roll;\n    float light_dist;\n    float cone;\n    float su;\n    int lm_n;\n    int lm_steps;\n    float thick;\n    int interior;\n    int shadows;\n  local:\n    float Wf;\n    float Hf;\n    float3 Lfwd;\n    float3 Lright;\n    float3 Lup;\n    float3 Ltoward;\n    float3 Lpos;\n    float tanc;\n    float thick_su;\n    float bias;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n    defineParam(light_type, \"light_type\", 0);\n    defineParam(aim, \"aim\", float3(0.0f, 0.0f, 0.0f));\n    defineParam(light_az, \"light_az\", 25.0f);\n    defineParam(light_el, \"light_el\", 33.0f);\n    defineParam(roll, \"roll\", 0.0f);\n    defineParam(light_dist, \"light_dist\", 4.0f);\n    defineParam(cone, \"cone\", 40.0f);\n    defineParam(su, \"su\", 0.01f);\n    defineParam(lm_n, \"lm_n\", 1024);\n    defineParam(lm_steps, \"lm_steps\", 224);\n    defineParam(thick, \"thick\", 0.4f);\n    defineParam(interior, \"interior\", 0);\n    defineParam(shadows, \"shadows\", 0);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  // ---- the light (mirrors rayfield/lightmath.py)\n  // Needs params light_type aim light_az light_el roll distance cone su, and locals\n  // Lfwd Lright Lup Ltoward Lpos tanc (set by light_setup() in init()).\n  float3 kelvin_rgb(float K) \{\n    float t = K / 100.0f;\n    float r = 255.0f;\n    float g = 0.0f;\n    float b = 255.0f;\n    if (t <= 66.0f) \{\n      g = 99.4708025861f * log(t) - 161.1195681661f;\n    \} else \{\n      r = 329.698727446f * pow(t - 60.0f, -0.1332047592f);\n      g = 288.1221695283f * pow(t - 60.0f, -0.0755148492f);\n    \}\n    if (t < 66.0f) \{\n      if (t <= 19.0f) \{\n        b = 0.0f;\n      \} else \{\n        b = 138.5177312231f * log(t - 10.0f) - 305.0447927307f;\n      \}\n    \}\n    float3 c = float3(pow(clamp(r, 0.0f, 255.0f) / 255.0f, 2.2f), pow(clamp(g, 0.0f, 255.0f) / 255.0f, 2.2f),\n                      pow(clamp(b, 0.0f, 255.0f) / 255.0f, 2.2f));\n    return c / (0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z);\n  \}\n  // unit vector toward the light (Y up); heading 0 = the light travels toward +X\n  float3 light_dir(float az, float el) \{\n    float a = az * 0.0174532925f;\n    float e = el * 0.0174532925f;\n    return float3(-cos(a) * cos(e), sin(e), -sin(a) * cos(e));\n  \}\n  void light_setup() \{\n    Ltoward = light_dir(light_az, light_el);\n    Lfwd = Ltoward * -1.0f;\n    float3 ref = fabs(Lfwd.y) < 0.999f ? float3(0.0f, 1.0f, 0.0f) : float3(0.0f, 0.0f, -1.0f);\n    float3 r0 = unit3(cross(Lfwd, ref));\n    float3 u0 = cross(r0, Lfwd);\n    float ca = cos(roll * 0.0174532925f);\n    float sa = sin(roll * 0.0174532925f);\n    Lright = r0 * ca + u0 * sa;\n    Lup = u0 * ca - r0 * sa;\n    Lpos = aim + Ltoward * (light_dist / su);\n    tanc = tan(clamp(cone, 1.0f, 170.0f) * 0.5f * 0.0174532925f);\n  \}\n  // light-space coordinates of a world point: (lu, lv, lt, valid).\n  // sun: lu, lv across the light from the aim point (scene units), lt along it.\n  // spot: lu, lv in the cone (-1..1 at its edge), lt = distance from the light.\n  float4 light_coords(float3 X) \{\n    if (light_type == 0) \{\n      float3 q = X - aim;\n      return float4(dot(q, Lright), dot(q, Lup), dot(q, Lfwd), 1.0f);\n    \}\n    float3 q = X - Lpos;\n    float z = dot(q, Lfwd);\n    if (z <= 1e-6f) \{\n      return float4(0.0f, 0.0f, len3(q), 0.0f);\n    \}\n    float zs = z * tanc;\n    return float4(dot(q, Lright) / zs, dot(q, Lup) / zs, len3(q), 1.0f);\n  \}\n  // Henyey-Greenstein, 1 everywhere at g = 0\n  float hg(float c, float g) \{\n    return (1.0f - g * g) / pow(max(1.0f + g * g - 2.0f * g * c, 1e-4f), 1.5f);\n  \}\n  void init() \{\n    Wf = float(surf.bounds.width());\n    Hf = float(surf.bounds.height());\n    light_setup();\n    thick_su = thick / su;\n    bias = 0.005f / su;\n  \}\n\n  bool blocked(float3 X) \{\n    float3 p = project_mid(X);\n    if (p.z <= 0.0f || p.x < 0.0f || p.y < 0.0f || p.x >= Wf || p.y >= Hf) \{\n      return false;\n    \}\n    float4 s = surf(surf.bounds.x1 + int(p.x), surf.bounds.y1 + int(p.y));\n    if (s.y < 0.5f || s.x <= 0.0f) \{\n      return false;\n    \}\n    float xd = len3(X - cam_pos);\n    return xd > s.x * 1.003f + bias && xd < s.x + thick_su;\n  \}\n\n  void process(int2 xy) \{\n    int fx0 = info.bounds.x1;\n    int fy0 = info.bounds.y1;\n    int x = xy.x - space.bounds.x1;\n    int y = xy.y - space.bounds.y1;\n    if (x >= lm_n || y >= lm_n || shadows == 1) \{\n      dst() = float4(1e20f, 1e20f, 0.0f, 0.0f);\n      return;\n    \}\n    float4 f0 = info(fx0, fy0);\n    float4 f1 = info(fx0 + 1, fy0);\n    float4 f2 = info(fx0 + 2, fy0);\n    float3 lo = float3(f0.x, f0.y, f0.z);\n    float3 hi = float3(f1.x, f1.y, f1.z);\n    float3 O = Lpos;\n    float3 D = Lfwd;\n    if (light_type == 0) \{\n      float lu = f2.x + (float(x) + 0.5f) * f2.z;\n      float lv = f2.y + (float(y) + 0.5f) * f2.z;\n      O = aim + Lright * lu + Lup * lv;\n    \} else \{\n      float uu = (float(x) + 0.5f) / float(lm_n) * 2.0f - 1.0f;\n      float vv = (float(y) + 0.5f) / float(lm_n) * 2.0f - 1.0f;\n      D = unit3(Lfwd + Lright * (uu * tanc) + Lup * (vv * tanc));\n    \}\n    // the set's box, padded a little\n    float pad = 0.01f * len3(hi - lo) + 0.01f / su;\n    float3 lo2 = lo - float3(pad);\n    float3 hi2 = hi + float3(pad);\n    float dx = fabs(D.x) < 1e-9f ? 1e-9f : D.x;\n    float dy = fabs(D.y) < 1e-9f ? 1e-9f : D.y;\n    float dz = fabs(D.z) < 1e-9f ? 1e-9f : D.z;\n    float ax = (lo2.x - O.x) / dx;\n    float bx = (hi2.x - O.x) / dx;\n    float ay = (lo2.y - O.y) / dy;\n    float by = (hi2.y - O.y) / dy;\n    float az = (lo2.z - O.z) / dz;\n    float bz = (hi2.z - O.z) / dz;\n    float tn = max(max(min(ax, bx), min(ay, by)), min(az, bz));\n    float tf = min(min(max(ax, bx), max(ay, by)), max(az, bz));\n    if (light_type == 1) \{\n      tn = max(tn, 0.0f);\n    \}\n    if (!(tf > tn)) \{\n      dst() = float4(1e20f, 1e20f, 0.0f, 0.0f);\n      return;\n    \}\n    // march to the first blocker, then narrow it down. With 'Light only through openings', light gets into the\n    // set once its ray has been outside an opening the camera sees (sky or the far outside, farther than the opening\n    // itself, from the openings image): a ray that reaches air the camera sees inside the set without having done so\n    // came through a wall or a roof the camera cannot see: no light gets in along it at all.\n    bool inside = light_type == 1 && Lpos.x > lo2.x && Lpos.y > lo2.y && Lpos.z > lo2.z && Lpos.x < hi2.x &&\n                  Lpos.y < hi2.y && Lpos.z < hi2.z;\n    bool open = interior == 0 || inside;\n    float rch = f1.w;\n    float t0 = tn;\n    if (!open) \{\n      t0 = tn - (0.05f * len3(hi - lo) + thick_su);\n      if (light_type == 1) \{\n        t0 = max(t0, 0.0f);\n      \}\n    \}\n    float ow = float(opn.bounds.width());\n    float oh = float(opn.bounds.height());\n    float dt = (tf - t0) / float(lm_steps);\n    float tb = 1e20f;\n    bool found = false;\n    for (int k = 0; k < lm_steps; k++) \{\n      float t = t0 + (float(k) + 0.5f) * dt;\n      float3 X = O + D * t;\n      float3 p = project_mid(X);\n      if (p.z <= 0.0f || p.x < 0.0f || p.y < 0.0f || p.x >= Wf || p.y >= Hf) \{\n        continue;\n      \}\n      float4 sv = surf(surf.bounds.x1 + int(p.x), surf.bounds.y1 + int(p.y));\n      float xd = len3(X - cam_pos);\n      if (sv.y >= 0.5f && sv.x > 0.0f && xd > sv.x * 1.003f + bias && xd < sv.x + thick_su) \{\n        tb = t;\n        found = true;\n        break;\n      \}\n      if (!open) \{\n        bool sky = sv.y <= 0.02f || sv.x <= 0.0f || sv.x > rch;\n        bool seen = sv.x > xd * 1.003f + bias;\n        if (sky) \{\n          // the camera sees an opening here: beyond its depth is outside, in front of it is the room's air\n          float4 o = opn(opn.bounds.x1 + clampi(int(p.x * ow / Wf), 0, int(ow) - 1),\n                         opn.bounds.y1 + clampi(int(p.y * oh / Hf), 0, int(oh) - 1));\n          open = o.y < 0.5f || xd > o.x * 1.003f + bias;\n          seen = !open;\n        \}\n        if (!open && seen) \{\n          tb = t0;\n          break;\n        \}\n      \}\n    \}\n    if (!open) \{\n      // never came in through an opening (it may still cross a corner of the frame between two steps): dark\n      tb = t0;\n      found = false;\n    \}\n    if (found) \{\n      float a = max(tb - dt, t0);\n      float b = tb;\n      for (int it = 0; it < 5; it++) \{\n        float m = 0.5f * (a + b);\n        if (blocked(O + D * m)) \{\n          b = m;\n        \} else \{\n          a = m;\n        \}\n      \}\n      tb = b;\n    \}\n    dst() = float4(tb, tn, open ? 1.0f : 0.0f, 0.0f);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name rf_lightmap
 onCreate "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _rf(_g).link_kernel(_g, 'rf_lightmap')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -300
}
set Nrf_lightmap [stack 0]
Constant {
 inputs 0
 channels rgba
 color {0 0 0 0}
 format "512 512 0 0 512 512 1 rf_space_noise_fmt"
 name rf_space_noise
 xpos -250
 ypos -240
}
set Nrf_space_noise [stack 0]
BlinkScript {
 inputs 1
 kernelSource "// RayField: a tiling 3D noise for the haze's breakup, 64 x 64 x 64 voxels laid out as 8 x 8 tiles of 64 x 64 in a\n// 512 x 512 image (tile k = slice z). r and g are two independent smooth value noises, one lattice cell every\n// 8 voxels, from the integer hash, so they are the same on every machine. Depends only on the seed, so Nuke keeps it.\n// Mirrors reference.noise_atlas.\nkernel RFNoise : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eWrite> dst;\n\n  param:\n    int seed;\n  void define() \{\n    defineParam(seed, \"seed\", 1);\n  \}\n\n\n  // ---- the hash: PCG on 32-bit words, kept as two 16-bit halves (x = high, y = low) so no int ever overflows.\n  // The same bits come out on every CPU and GPU, and they match the Python reference (rayfield/rng.py).\n  int2 u_add(int2 a, int2 b) \{\n    int lo = a.y + b.y;\n    return int2((a.x + b.x + (lo >> 16)) & 65535, lo & 65535);\n  \}\n  int mul_lo16(int a, int b) \{\n    return (a * (b & 255) + (((a * (b >> 8)) & 255) << 8)) & 65535;\n  \}\n  int2 u_mul(int2 a, int2 b) \{\n    int p0 = a.y * (b.y & 255);\n    int p1 = a.y * (b.y >> 8);\n    int t = p0 + ((p1 & 255) << 8);\n    int carry = (t >> 16) + (p1 >> 8);\n    return int2((carry + mul_lo16(a.x, b.y) + mul_lo16(a.y, b.x)) & 65535, t & 65535);\n  \}\n  int2 u_xor(int2 a, int2 b) \{\n    return int2(a.x ^ b.x, a.y ^ b.y);\n  \}\n  int2 u_shr(int2 a, int k) \{\n    if (k >= 16) \{\n      return int2(0, a.x >> (k - 16));\n    \}\n    return int2(a.x >> k, ((a.y >> k) | (a.x << (16 - k))) & 65535);\n  \}\n  int2 pcg(int2 v) \{\n    int2 s = u_add(u_mul(v, int2(11410, 30645)), int2(44118, 19205));\n    int2 w = u_mul(u_xor(u_shr(s, (s.x >> 12) + 4), s), int2(4238, 62169));\n    return u_xor(u_shr(w, 22), w);\n  \}\n  int2 word(int v) \{\n    return int2((v >> 16) & 65535, v & 65535);\n  \}\n  int2 hash1(int2 a) \{\n    return pcg(a);\n  \}\n  int2 hash_more(int2 h, int2 w) \{\n    return pcg(u_add(h, w));\n  \}\n  float u01(int2 h) \{\n    return float((h.x << 8) | (h.y >> 8)) * (1.0f / 16777216.0f);\n  \}\n  float fade5(float f) \{\n    return f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);\n  \}\n\n  float lattice(int c, int cx, int cy, int cz) \{\n    int idx = cx + 8 * (cy + 8 * cz);\n    int2 h = hash_more(hash_more(hash_more(hash1(word(seed)), word(1313818963)), word(c)), word(idx));\n    return u01(h);\n  \}\n\n  float value_noise(int c, int i, int j, int k) \{\n    int cx = i / 8;\n    int cy = j / 8;\n    int cz = k / 8;\n    float wx = fade5(float(i % 8) / 8.0f);\n    float wy = fade5(float(j % 8) / 8.0f);\n    float wz = fade5(float(k % 8) / 8.0f);\n    int cx1 = (cx + 1) % 8;\n    int cy1 = (cy + 1) % 8;\n    int cz1 = (cz + 1) % 8;\n    float a = lattice(c, cx, cy, cz) * (1.0f - wx) + lattice(c, cx1, cy, cz) * wx;\n    float b = lattice(c, cx, cy1, cz) * (1.0f - wx) + lattice(c, cx1, cy1, cz) * wx;\n    float d = lattice(c, cx, cy, cz1) * (1.0f - wx) + lattice(c, cx1, cy, cz1) * wx;\n    float e = lattice(c, cx, cy1, cz1) * (1.0f - wx) + lattice(c, cx1, cy1, cz1) * wx;\n    return (a * (1.0f - wy) + b * wy) * (1.0f - wz) + (d * (1.0f - wy) + e * wy) * wz;\n  \}\n\n  void process(int2 xy) \{\n    int x = xy.x - space.bounds.x1;\n    int y = xy.y - space.bounds.y1;\n    int i = x % 64;\n    int j = y % 64;\n    int k = (y / 64) * 8 + x / 64;\n    dst() = float4(value_noise(0, i, j, k), value_noise(1, i, j, k), 0.0f, 0.0f);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name rf_noise
 onCreate "import sys, types, nuke\ndef _rf(grp):\n    src = grp\['rf_py'\].value()\n    m = sys.modules.get('_rayfield_node')\n    if m is None or getattr(m, '_rf_src', None) != src:\n        m = types.ModuleType('_rayfield_node')\n        exec(compile(src, 'RayField', 'exec'), m.__dict__)\n        m._rf_src = src\n        sys.modules\['_rayfield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _rf(_g).link_kernel(_g, 'rf_noise')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -240
}
set Nrf_noise [stack 0]
push $Nrf_noise
push $Nrf_cuc
push $Nrf_lightmap
push $Nrf_frame
push $Nrf_surface
push $Nrf_surface
Reformat {
 type scale
 scale {{parent.rf_res} {parent.rf_res}}
 name rf_low
 xpos -250
 ypos -180
}
set Nrf_low [stack 0]
BlinkScript {
 inputs 6
 kernelSource "// RayField: the air along each pixel's ray, from the camera out to the surface (the unfiltered depth) or as far as\n// the haze reaches (where it sees sky: to where the ray leaves the set, or Haze reaches). At each step: the haze's density (even haze, ground fog, breakup), the light that reaches the\n// point (shadows from the light map, the cuc, the cone, falloff, fade), how much of it scatters toward the camera\n// (glow toward the light), and ambient haze; all dimmed by the haze in front. Runs at the size of the space image\n// (a fraction of the frame) and starts each pixel's steps at a fixed offset (stratified), so there is no banding.\n// Out: rgb = the light the air adds, a = how much the haze hides what is behind it. Mirrors reference.march.\nkernel RFMarch : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eRead, eAccessRandom, eEdgeClamped> info;\n  Image<eRead, eAccessRandom, eEdgeClamped> lmap;\n  Image<eRead, eAccessRandom, eEdgeClamped> cuc;\n  Image<eRead, eAccessRandom, eEdgeClamped> noise;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n    int light_type;\n    float3 aim;\n    float light_az;\n    float light_el;\n    float roll;\n    float light_dist;\n    float cone;\n    float su;\n    int lm_n;\n    float cone_soft;\n    float falloff;\n    float light_k;\n    float3 light_col;\n    float haze;\n    float glow;\n    float ambient;\n    float3 ambient_rgb;\n    float fade;\n    float fog;\n    float fog_height;\n    float fog_falloff;\n    float breakup;\n    float breakup_size;\n    float drift;\n    float drift_dir;\n    float frame;\n    float fps;\n    int seed;\n    int use_cuc;\n    float cuc_size;\n    float cuc_aspect;\n    int cuc_outside;\n    int steps;\n    int octaves;\n    float reach;\n  local:\n    float Wf;\n    float Hf;\n    float sxf;\n    float syf;\n    float3 Lfwd;\n    float3 Lright;\n    float3 Lup;\n    float3 Ltoward;\n    float3 Lpos;\n    float tanc;\n    float3 col;\n    float3 amb;\n    float3 drift_off;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n    defineParam(light_type, \"light_type\", 0);\n    defineParam(aim, \"aim\", float3(0.0f, 0.0f, 0.0f));\n    defineParam(light_az, \"light_az\", 25.0f);\n    defineParam(light_el, \"light_el\", 33.0f);\n    defineParam(roll, \"roll\", 0.0f);\n    defineParam(light_dist, \"light_dist\", 4.0f);\n    defineParam(cone, \"cone\", 40.0f);\n    defineParam(su, \"su\", 0.01f);\n    defineParam(lm_n, \"lm_n\", 1024);\n    defineParam(cone_soft, \"cone_soft\", 0.2f);\n    defineParam(falloff, \"falloff\", 1.0f);\n    defineParam(light_k, \"light_k\", 5600.0f);\n    defineParam(light_col, \"light_col\", float3(1.0f, 1.0f, 1.0f));\n    defineParam(haze, \"haze\", 0.3f);\n    defineParam(glow, \"glow\", 0.5f);\n    defineParam(ambient, \"ambient\", 0.02f);\n    defineParam(ambient_rgb, \"ambient_rgb\", float3(0.85f, 0.92f, 1.0f));\n    defineParam(fade, \"fade\", 0.0f);\n    defineParam(fog, \"fog\", 0.0f);\n    defineParam(fog_height, \"fog_height\", 0.5f);\n    defineParam(fog_falloff, \"fog_falloff\", 0.5f);\n    defineParam(breakup, \"breakup\", 0.5f);\n    defineParam(breakup_size, \"breakup_size\", 0.6f);\n    defineParam(drift, \"drift\", 0.05f);\n    defineParam(drift_dir, \"drift_dir\", 0.0f);\n    defineParam(frame, \"frame\", 1001.0f);\n    defineParam(fps, \"fps\", 24.0f);\n    defineParam(seed, \"seed\", 1);\n    defineParam(use_cuc, \"use_cuc\", 0);\n    defineParam(cuc_size, \"cuc_size\", 3.0f);\n    defineParam(cuc_aspect, \"cuc_aspect\", 1.0f);\n    defineParam(cuc_outside, \"cuc_outside\", 0);\n    defineParam(steps, \"steps\", 96);\n    defineParam(octaves, \"octaves\", 2);\n    defineParam(reach, \"reach\", 0.0f);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the hash: PCG on 32-bit words, kept as two 16-bit halves (x = high, y = low) so no int ever overflows.\n  // The same bits come out on every CPU and GPU, and they match the Python reference (rayfield/rng.py).\n  int2 u_add(int2 a, int2 b) \{\n    int lo = a.y + b.y;\n    return int2((a.x + b.x + (lo >> 16)) & 65535, lo & 65535);\n  \}\n  int mul_lo16(int a, int b) \{\n    return (a * (b & 255) + (((a * (b >> 8)) & 255) << 8)) & 65535;\n  \}\n  int2 u_mul(int2 a, int2 b) \{\n    int p0 = a.y * (b.y & 255);\n    int p1 = a.y * (b.y >> 8);\n    int t = p0 + ((p1 & 255) << 8);\n    int carry = (t >> 16) + (p1 >> 8);\n    return int2((carry + mul_lo16(a.x, b.y) + mul_lo16(a.y, b.x)) & 65535, t & 65535);\n  \}\n  int2 u_xor(int2 a, int2 b) \{\n    return int2(a.x ^ b.x, a.y ^ b.y);\n  \}\n  int2 u_shr(int2 a, int k) \{\n    if (k >= 16) \{\n      return int2(0, a.x >> (k - 16));\n    \}\n    return int2(a.x >> k, ((a.y >> k) | (a.x << (16 - k))) & 65535);\n  \}\n  int2 pcg(int2 v) \{\n    int2 s = u_add(u_mul(v, int2(11410, 30645)), int2(44118, 19205));\n    int2 w = u_mul(u_xor(u_shr(s, (s.x >> 12) + 4), s), int2(4238, 62169));\n    return u_xor(u_shr(w, 22), w);\n  \}\n  int2 word(int v) \{\n    return int2((v >> 16) & 65535, v & 65535);\n  \}\n  int2 hash1(int2 a) \{\n    return pcg(a);\n  \}\n  int2 hash_more(int2 h, int2 w) \{\n    return pcg(u_add(h, w));\n  \}\n  float u01(int2 h) \{\n    return float((h.x << 8) | (h.y >> 8)) * (1.0f / 16777216.0f);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  // ---- the light (mirrors rayfield/lightmath.py)\n  // Needs params light_type aim light_az light_el roll distance cone su, and locals\n  // Lfwd Lright Lup Ltoward Lpos tanc (set by light_setup() in init()).\n  float3 kelvin_rgb(float K) \{\n    float t = K / 100.0f;\n    float r = 255.0f;\n    float g = 0.0f;\n    float b = 255.0f;\n    if (t <= 66.0f) \{\n      g = 99.4708025861f * log(t) - 161.1195681661f;\n    \} else \{\n      r = 329.698727446f * pow(t - 60.0f, -0.1332047592f);\n      g = 288.1221695283f * pow(t - 60.0f, -0.0755148492f);\n    \}\n    if (t < 66.0f) \{\n      if (t <= 19.0f) \{\n        b = 0.0f;\n      \} else \{\n        b = 138.5177312231f * log(t - 10.0f) - 305.0447927307f;\n      \}\n    \}\n    float3 c = float3(pow(clamp(r, 0.0f, 255.0f) / 255.0f, 2.2f), pow(clamp(g, 0.0f, 255.0f) / 255.0f, 2.2f),\n                      pow(clamp(b, 0.0f, 255.0f) / 255.0f, 2.2f));\n    return c / (0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z);\n  \}\n  // unit vector toward the light (Y up); heading 0 = the light travels toward +X\n  float3 light_dir(float az, float el) \{\n    float a = az * 0.0174532925f;\n    float e = el * 0.0174532925f;\n    return float3(-cos(a) * cos(e), sin(e), -sin(a) * cos(e));\n  \}\n  void light_setup() \{\n    Ltoward = light_dir(light_az, light_el);\n    Lfwd = Ltoward * -1.0f;\n    float3 ref = fabs(Lfwd.y) < 0.999f ? float3(0.0f, 1.0f, 0.0f) : float3(0.0f, 0.0f, -1.0f);\n    float3 r0 = unit3(cross(Lfwd, ref));\n    float3 u0 = cross(r0, Lfwd);\n    float ca = cos(roll * 0.0174532925f);\n    float sa = sin(roll * 0.0174532925f);\n    Lright = r0 * ca + u0 * sa;\n    Lup = u0 * ca - r0 * sa;\n    Lpos = aim + Ltoward * (light_dist / su);\n    tanc = tan(clamp(cone, 1.0f, 170.0f) * 0.5f * 0.0174532925f);\n  \}\n  // light-space coordinates of a world point: (lu, lv, lt, valid).\n  // sun: lu, lv across the light from the aim point (scene units), lt along it.\n  // spot: lu, lv in the cone (-1..1 at its edge), lt = distance from the light.\n  float4 light_coords(float3 X) \{\n    if (light_type == 0) \{\n      float3 q = X - aim;\n      return float4(dot(q, Lright), dot(q, Lup), dot(q, Lfwd), 1.0f);\n    \}\n    float3 q = X - Lpos;\n    float z = dot(q, Lfwd);\n    if (z <= 1e-6f) \{\n      return float4(0.0f, 0.0f, len3(q), 0.0f);\n    \}\n    float zs = z * tanc;\n    return float4(dot(q, Lright) / zs, dot(q, Lup) / zs, len3(q), 1.0f);\n  \}\n  // Henyey-Greenstein, 1 everywhere at g = 0\n  float hg(float c, float g) \{\n    return (1.0f - g * g) / pow(max(1.0f + g * g - 2.0f * g * c, 1e-4f), 1.5f);\n  \}\n  // ---- the light reaching a point: the light map's shadows, the cuc, the cone, falloff and fade\n  // (mirrors reference.Lighting). Needs images lmap and cuc, params lm_n light_type cone_soft distance falloff haze\n  // fade su cuc_size cuc_aspect cuc_outside, and lib_light.\n  int posmodi(int a, int m) \{\n    int r = a % m;\n    return r < 0 ? r + m : r;\n  \}\n  // light-map pixel coordinates of (lu, lv); lf = (u0, v0, step) of the sun's frame\n  float2 texel_of(float lu, float lv, float3 lf) \{\n    if (light_type == 0) \{\n      return float2((lu - lf.x) / lf.z, (lv - lf.y) / lf.z);\n    \}\n    float n = float(lm_n);\n    return float2((lu * 0.5f + 0.5f) * n, (lv * 0.5f + 0.5f) * n);\n  \}\n  // how much of the light gets to distance t along the light (bilinear over the light map's pixels)\n  float shadow_at(float tx, float ty, float t, float bias) \{\n    float n = float(lm_n);\n    if (tx < 0.0f || ty < 0.0f || tx >= n || ty >= n) \{\n      return 1.0f;\n    \}\n    float fx = tx - 0.5f;\n    float fy = ty - 0.5f;\n    float x0f = floor(fx);\n    float y0f = floor(fy);\n    float ax = fx - x0f;\n    float ay = fy - y0f;\n    int x0 = int(x0f);\n    int y0 = int(y0f);\n    int xa = clampi(x0, 0, lm_n - 1);\n    int xb = clampi(x0 + 1, 0, lm_n - 1);\n    int ya = clampi(y0, 0, lm_n - 1);\n    int yb = clampi(y0 + 1, 0, lm_n - 1);\n    int bx = lmap.bounds.x1;\n    int by = lmap.bounds.y1;\n    float v00 = t < lmap(bx + xa, by + ya).x + bias ? 1.0f : 0.0f;\n    float v10 = t < lmap(bx + xb, by + ya).x + bias ? 1.0f : 0.0f;\n    float v01 = t < lmap(bx + xa, by + yb).x + bias ? 1.0f : 0.0f;\n    float v11 = t < lmap(bx + xb, by + yb).x + bias ? 1.0f : 0.0f;\n    return (v00 * (1.0f - ax) + v10 * ax) * (1.0f - ay) + (v01 * (1.0f - ax) + v11 * ax) * ay;\n  \}\n  // where the light ray through this light-map pixel enters the set (1e20 = it misses it)\n  float entry_at(float tx, float ty) \{\n    int xi = clampi(int(tx), 0, lm_n - 1);\n    int yi = clampi(int(ty), 0, lm_n - 1);\n    return lmap(lmap.bounds.x1 + xi, lmap.bounds.y1 + yi).y;\n  \}\n  float3 cuc_px(int x, int y) \{\n    float4 c = cuc(cuc.bounds.x1 + x, cuc.bounds.y1 + y);\n    return float3(max(c.x, 0.0f), max(c.y, 0.0f), max(c.z, 0.0f));\n  \}\n  // the cuc's colour at (lu, lv): bilinear; outside it dark, light or repeated\n  float3 cuc_at(float lu, float lv) \{\n    float cu = 0.0f;\n    float cv = 0.0f;\n    if (light_type == 1) \{\n      cu = lu * 0.5f + 0.5f;\n      cv = lv * 0.5f * cuc_aspect + 0.5f;\n    \} else \{\n      float sz = cuc_size / su;\n      cu = lu / sz + 0.5f;\n      cv = lv / sz * cuc_aspect + 0.5f;\n    \}\n    if (cuc_outside != 2 && (cu < 0.0f || cu > 1.0f || cv < 0.0f || cv > 1.0f)) \{\n      return float3(cuc_outside == 0 ? 0.0f : 1.0f);\n    \}\n    int W = cuc.bounds.width();\n    int H = cuc.bounds.height();\n    float px = cu * float(W) - 0.5f;\n    float py = cv * float(H) - 0.5f;\n    float x0f = floor(px);\n    float y0f = floor(py);\n    float ax = px - x0f;\n    float ay = py - y0f;\n    int x0 = int(x0f);\n    int y0 = int(y0f);\n    int xa = 0;\n    int xb = 0;\n    int ya = 0;\n    int yb = 0;\n    if (cuc_outside == 2) \{\n      xa = posmodi(x0, W);\n      xb = posmodi(x0 + 1, W);\n      ya = posmodi(y0, H);\n      yb = posmodi(y0 + 1, H);\n    \} else \{\n      xa = clampi(x0, 0, W - 1);\n      xb = clampi(x0 + 1, 0, W - 1);\n      ya = clampi(y0, 0, H - 1);\n      yb = clampi(y0 + 1, 0, H - 1);\n    \}\n    return (cuc_px(xa, ya) * (1.0f - ax) + cuc_px(xb, ya) * ax) * (1.0f - ay) +\n           (cuc_px(xa, yb) * (1.0f - ax) + cuc_px(xb, yb) * ax) * ay;\n  \}\n  // the cone's edge, distance falloff and fade along the light since it entered the set\n  float light_weight(float lu, float lv, float lt, float tx, float ty) \{\n    float w = 1.0f;\n    if (light_type == 1) \{\n      float r = sqrt(lu * lu + lv * lv);\n      float soft = max(cone_soft, 1e-4f);\n      w = 1.0f - smooth01((r - (1.0f - cone_soft)) / soft);\n      float dm = max(lt * su, 0.01f);\n      w = w * min(pow(light_dist / dm, 2.0f * falloff), 100.0f);\n    \}\n    float te = entry_at(tx, ty);\n    float run = te < 5e19f ? max(lt - te, 0.0f) * su : 0.0f;\n    float ext = haze * 0.050000f + (fade > 0.0f ? 1.0f / fade : 0.0f);\n    return w * exp(-run * ext);\n  \}\n  void init() \{\n    Wf = float(surf.bounds.width());\n    Hf = float(surf.bounds.height());\n    sxf = Wf / float(space.bounds.width());\n    syf = Hf / float(space.bounds.height());\n    light_setup();\n    col = light_col * kelvin_rgb(light_k);\n    amb = ambient_rgb * (ambient * (0.2126f * col.x + 0.7152f * col.y + 0.0722f * col.z));\n    float a = drift_dir * 0.0174532925f;\n    drift_off = float3(cos(a), 0.0f, sin(a)) * (drift * frame / fps);\n  \}\n\n  // the two noises at voxel coordinates q (trilinear, wrapping every 64 voxels)\n  float2 noise_at(float3 q) \{\n    float fx = floor(q.x);\n    float fy = floor(q.y);\n    float fz = floor(q.z);\n    int i0 = posmodi(int(fx), 64);\n    int j0 = posmodi(int(fy), 64);\n    int k0 = posmodi(int(fz), 64);\n    int i1 = (i0 + 1) % 64;\n    int j1 = (j0 + 1) % 64;\n    int k1 = (k0 + 1) % 64;\n    float wx = q.x - fx;\n    float wy = q.y - fy;\n    float wz = q.z - fz;\n    int nx = noise.bounds.x1;\n    int ny = noise.bounds.y1;\n    int ax = nx + (k0 % 8) * 64;\n    int ay = ny + (k0 / 8) * 64;\n    int bx = nx + (k1 % 8) * 64;\n    int by = ny + (k1 / 8) * 64;\n    float4 a00 = noise(ax + i0, ay + j0);\n    float4 a10 = noise(ax + i1, ay + j0);\n    float4 a01 = noise(ax + i0, ay + j1);\n    float4 a11 = noise(ax + i1, ay + j1);\n    float4 b00 = noise(bx + i0, by + j0);\n    float4 b10 = noise(bx + i1, by + j0);\n    float4 b01 = noise(bx + i0, by + j1);\n    float4 b11 = noise(bx + i1, by + j1);\n    float4 a = (a00 * (1.0f - wx) + a10 * wx) * (1.0f - wy) + (a01 * (1.0f - wx) + a11 * wx) * wy;\n    float4 b = (b00 * (1.0f - wx) + b10 * wx) * (1.0f - wy) + (b01 * (1.0f - wx) + b11 * wx) * wy;\n    float4 r = a * (1.0f - wz) + b * wz;\n    return float2(r.x, r.y);\n  \}\n\n  // where the camera's ray leaves the set's box (padded as the light map pads it); 0 if it misses the box\n  float box_exit(float3 d, float3 lo, float3 hi) \{\n    float pad = 0.01f * len3(hi - lo) + 0.01f / su;\n    float3 lo2 = lo - float3(pad);\n    float3 hi2 = hi + float3(pad);\n    float dx = fabs(d.x) < 1e-9f ? 1e-9f : d.x;\n    float dy = fabs(d.y) < 1e-9f ? 1e-9f : d.y;\n    float dz = fabs(d.z) < 1e-9f ? 1e-9f : d.z;\n    float ax = (lo2.x - cam_pos.x) / dx;\n    float bx = (hi2.x - cam_pos.x) / dx;\n    float ay = (lo2.y - cam_pos.y) / dy;\n    float by = (hi2.y - cam_pos.y) / dy;\n    float az = (lo2.z - cam_pos.z) / dz;\n    float bz = (hi2.z - cam_pos.z) / dz;\n    float tn = max(max(min(ax, bx), min(ay, by)), min(az, bz));\n    float tf = min(min(max(ax, bx), max(ay, by)), max(az, bz));\n    return (tf > max(tn, 0.0f)) ? tf : 0.0f;\n  \}\n\n  // the haze's density at X, per metre\n  float density(float3 X) \{\n    float ym = X.y * su;\n    float base = haze + fog * exp(-max(ym - fog_height, 0.0f) / max(fog_falloff, 0.01f));\n    float sig = base * 0.050000f;\n    if (breakup > 0.0f) \{\n      float3 q = (X * su + drift_off) / breakup_size * 8.0f;\n      float n = noise_at(q).x;\n      if (octaves > 1) \{\n        float3 q2 = float3(0.8f * q.x - 0.36f * q.y + 0.48f * q.z, 0.6f * q.x + 0.48f * q.y - 0.64f * q.z,\n                           0.8f * q.y + 0.6f * q.z) * 2.17f + float3(17.3f, 5.1f, 31.7f);\n        n = 0.62f * n + 0.38f * noise_at(q2).y;\n      \}\n      float m = clamp((n - 0.5f) * 3.0f + 0.5f, 0.0f, 1.0f);\n      sig = sig * max(1.0f + breakup * (2.0f * m - 1.0f), 0.0f);\n    \}\n    return sig;\n  \}\n\n  void process(int2 xy) \{\n    float4 f0 = info(info.bounds.x1, info.bounds.y1);\n    float4 f1 = info(info.bounds.x1 + 1, info.bounds.y1);\n    float4 f2 = info(info.bounds.x1 + 2, info.bounds.y1);\n    float3 lf = float3(f2.x, f2.y, f2.z);\n    float rch = f1.w;\n    int W = surf.bounds.width();\n    int H = surf.bounds.height();\n    int ix = clampi(int((float(xy.x - space.bounds.x1) + 0.5f) * sxf), 0, W - 1);\n    int iy = clampi(int((float(xy.y - space.bounds.y1) + 0.5f) * syf), 0, H - 1);\n    float4 s = surf(surf.bounds.x1 + ix, surf.bounds.y1 + iy);\n    float3 d = ray_dir(float(ix) + 0.5f, float(iy) + 0.5f);\n    float D = 0.0f;\n    if (s.y >= 0.02f && s.x > 0.0f) \{\n      D = min(s.x, rch);\n    \} else if (reach > 0.0f) \{\n      D = rch;\n    \} else \{\n      D = min(box_exit(d, float3(f0.x, f0.y, f0.z), float3(f1.x, f1.y, f1.z)), rch);\n    \}\n    // where this pixel's steps start: stratified over each 4 x 4 block of pixels (an ordered pattern, shuffled within\n    // its slot by the hash), so the upsample's filter averages the offsets out\n    int mx = xy.x - space.bounds.x1;\n    int my = xy.y - space.bounds.y1;\n    int xa = (mx ^ my) & 3;\n    int bay = ((xa & 1) << 3) | ((my & 1) << 2) | (((xa >> 1) & 1) << 1) | ((my >> 1) & 1);\n    float jit = (float(bay) + u01(hash_more(hash_more(hash1(word(1246319700)), word(mx)), word(my)))) / 16.0f;\n    float dt = D / float(steps);\n    float dtm = dt * su;\n    float T = 1.0f;\n    float3 acc = float3(0.0f);\n    for (int k = 0; k < steps; k++) \{\n      float t = (float(k) + jit) * dt;\n      float3 X = cam_pos + d * t;\n      float sig = density(X);\n      if (sig <= 0.0f) \{\n        continue;\n      \}\n      float a = 1.0f - exp(-sig * dtm);\n      float3 li = float3(0.0f);\n      float4 c = light_coords(X);\n      if (c.w > 0.0f) \{\n        float2 tx = texel_of(c.x, c.y, lf);\n        float w = shadow_at(tx.x, tx.y, c.z, 0.0f);\n        if (w > 0.0f) \{\n          w = w * light_weight(c.x, c.y, c.z, tx.x, tx.y);\n          float3 Ld = light_type == 0 ? Lfwd : unit3(X - Lpos);\n          w = w * hg(-dot(Ld, d), glow);\n          float3 cc = use_cuc == 1 ? cuc_at(c.x, c.y) : float3(1.0f);\n          li = col * cc * w;\n        \}\n      \}\n      acc += (li + amb) * (T * a);\n      T = T * (1.0f - a);\n    \}\n    dst() = float4(acc.x, acc.y, acc.z, 1.0f - T);\n  \}\n\};\n"
